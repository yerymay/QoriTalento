---
import Panel from '../../compartido/components/ui/Panel.astro';
import Alert from '../../compartido/components/ui/Alert.astro';
import Button from '../../compartido/components/ui/Button.astro';
import Badge from '../../compartido/components/ui/Badge.astro';
import EmptyState from '../../compartido/components/ui/EmptyState.astro';
import Espacio from '../../auth/components/Espacio.astro';
import WizardPostulacion from './WizardPostulacion.astro';
import './postulaciones.css';
interface Props {view:'form'|'list'}
const {view}=Astro.props;
---
<Espacio view={view==='list'?'applications':'home'} role="CANDIDATE" title={view==='form'?'Envía tu postulación':'Mis postulaciones'} description={view==='form'?'Tu experiencia es el inicio de una nueva historia.':'Sigue cada paso de tu proceso.'}>
<div data-applications data-view={view} class="space-y-5">
  <Panel data-app-loading role="status" class="space-y-4 p-6"><p>Cargando información…</p><div class="ui-skeleton h-20"></div></Panel>
  <Alert data-app-notice role="status" tabindex="-1" hidden />
  <div data-app-recovery class="flex flex-wrap gap-3" hidden><Button variant="secondary" data-app-retry type="button">Reintentar</Button><a href="/postulante/postulaciones" class="q-link">Ver mis postulaciones</a></div>
  {view==='form'?<WizardPostulacion />:<section aria-label="Listado de postulaciones">
    <EmptyState data-app-empty title="Tu primera postulación te espera" description="Encuentra una vacante que encaje contigo y consulta aquí su avance." hidden><Button as="a" href="/postulante/ofertas">Explorar oportunidades</Button></EmptyState>
    <div data-app-list class="space-y-5"></div>
    <template data-card>
      <Panel as="article" class="space-y-5 p-5 sm:p-6">
        <div class="flex items-start justify-between gap-3"><div class="min-w-0"><h2 data-card-title class="break-words text-xl font-semibold"></h2><p data-card-meta class="mt-2 text-sm text-slate-600 dark:text-slate-300"></p></div>
          <div data-ui-menu class="ui-menu shrink-0"><Button variant="icon" data-ui-menu-trigger aria-haspopup="menu" aria-expanded="false" aria-label="Opciones de la postulación"><svg class="ui-icon" aria-hidden="true" viewBox="0 0 24 24" fill="currentColor"><circle cx="5" cy="12" r="1.5"/><circle cx="12" cy="12" r="1.5"/><circle cx="19" cy="12" r="1.5"/></svg></Button>
            <div data-card-menu role="menu" aria-label="Opciones de la postulación" class="ui-menu-popup" hidden>
              <a data-card-replace role="menuitem" hidden>Reemplazar CV</a>
              <a data-card-job role="menuitem">Ver oferta</a>
              <a href="/postulante/examenes" role="menuitem">Ver mis pruebas</a>
              <button type="button" role="menuitem" data-card-tracking>Ver seguimiento</button>
              <button type="button" role="menuitem" disabled>Ver evaluación</button><p class="px-3 py-2 text-sm text-slate-600 dark:text-slate-300">La evaluación aún no está disponible en esta vista.</p>
            </div>
          </div>
        </div>
        <Badge data-card-status /><p data-card-file class="break-words text-sm text-slate-600 dark:text-slate-300"></p>
        <section data-tracking tabindex="-1" aria-label="Seguimiento de tu postulación" class="border-t border-slate-200 pt-5 dark:border-slate-700">
          <ol class="application-tracking">
            <li data-state="complete"><span class="tracking-marker" aria-hidden="true"><svg class="ui-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="m5 12 4 4L19 6"/></svg></span><h3 class="mt-3 font-medium">Registrada</h3><p data-tracking-date class="mt-1 text-sm text-slate-600 dark:text-slate-300"></p></li>
            <li aria-current="step"><span class="tracking-marker" aria-hidden="true"><svg class="ui-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor"><circle cx="12" cy="12" r="8"/><path d="M12 7v5l3 2"/></svg></span><h3 class="mt-3 font-medium">Estado actual</h3><p data-tracking-status class="mt-1 text-sm text-slate-600 dark:text-slate-300"></p></li>
            <li><span class="tracking-marker" aria-hidden="true"><svg class="ui-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M5 3h14v18H5zM8 8h8M8 12h8M8 16h5"/></svg></span><h3 class="mt-3 font-medium">Evaluación</h3><p class="mt-1 text-sm text-slate-600 dark:text-slate-300">Aún no disponible</p></li>
          </ol>
          <p class="mt-4 text-sm text-slate-600 dark:text-slate-300">Se muestra el estado actual; el historial de cambios aún no está disponible.</p>
        </section>
        <div class="flex justify-end"><Button as="a" data-card-cv>Revisar datos del CV</Button></div>
      </Panel>
    </template>
  </section>}
</div>
</Espacio>
<script>import {initPostulaciones} from '../postulaciones';initPostulaciones();</script>
