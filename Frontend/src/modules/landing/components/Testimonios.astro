---
import { REVIEWS } from '../landing.reviews';
---
<section data-reviews role="region" aria-roledescription="carrusel" aria-label="Opiniones" class="bg-canvas px-5 pb-16 pt-8 sm:px-8 sm:pb-20">
  <div class="mx-auto max-w-6xl">
    <h2 data-review-text="title" class="text-center text-2xl font-bold text-slate-900 dark:text-white">Lo que dicen quienes la prueban</h2>
    <div data-track tabindex="0" aria-live="off" class="review-track mt-8" aria-label="Opiniones">
      {REVIEWS.map((review,i) => <article data-review role="group" aria-label={`${i+1} de ${REVIEWS.length}`} class="review-card ui-panel flex flex-col p-6 sm:p-7">
        {review.estrellas !== undefined && <div class="flex gap-1 text-sky-700 dark:text-sky-300" role="img" aria-label={`${review.estrellas} de 5 estrellas`} data-stars={review.estrellas}>
          {Array.from({length:review.estrellas},()=> <svg aria-hidden="true" class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor"><path d="m12 2 2.9 5.9 6.5.9-4.7 4.6 1.1 6.5-5.8-3-5.8 3 1.1-6.5L2.6 8.8l6.5-.9L12 2Z"/></svg>)}
        </div>}
        <blockquote class="mt-5 flex-1 text-base leading-7 text-slate-700 dark:text-slate-200" data-review-body={i}>{review.texto}</blockquote>
        <div class="mt-6 flex items-center gap-3"><span aria-hidden="true" class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-sky-100 font-semibold text-sky-800 dark:bg-sky-950 dark:text-sky-200">{review.nombre.split(' ').map(word=>word[0]).slice(0,2).join('').toUpperCase()}</span><div class="min-w-0"><p class="font-semibold text-slate-900 dark:text-white" data-review-name={i}>{review.nombre}</p><p class="text-sm text-slate-600 dark:text-slate-300" data-review-role={i}>{review.rol}</p></div></div>
      </article>)}
    </div>
  </div>
</section>
<style>
.review-track:focus-visible{outline:2px solid var(--color-sky-600);outline-offset:3px;}
.review-track{display:flex;gap:1rem;overflow-x:auto;scroll-snap-type:x proximity;scrollbar-width:none;overscroll-behavior-x:contain;padding:0 2px 8px;}
.review-track::-webkit-scrollbar{display:none;}
.review-card{flex:0 0 100%;min-width:0;scroll-snap-align:start;transition:transform 160ms ease-out,box-shadow 160ms ease-out;}
.review-card:hover{transform:translateY(-2px);box-shadow:var(--shadow-2);}
@media(min-width:640px){.review-card{flex-basis:calc((100% - 1rem)/2)}}
@media(min-width:1024px){.review-card{flex-basis:calc((100% - 2rem)/3)}}
@media(prefers-reduced-motion:reduce){.review-card{transition:none}.review-card:hover{transform:none}}
</style>
<script>import { iniciarTestimonios } from '../landing.reviews.client'; iniciarTestimonios();</script>
