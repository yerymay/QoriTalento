---
interface Props { owned: boolean }
const { owned } = Astro.props;
---
<div class="space-y-6">
  {!owned && <section class="rounded-xl bg-sky-900 p-6 text-white sm:p-8">
    <h2 class="text-2xl font-semibold">Tu próximo capítulo empieza con tu talento.</h2>
    <p class="mt-3 max-w-prose leading-relaxed text-sky-100">Explora las oportunidades y conoce lo que busca cada equipo.</p>
  </section>}
  <section class:list={['space-y-5', { 'q-card p-4 sm:p-6': owned }]} aria-label={owned ? 'Tus ofertas de empleo' : 'Oportunidades abiertas'}>
    {owned ? <form data-job-search data-job-list-control role="search" class="space-y-3" hidden>
      <label for="job-search" class="block font-medium">Buscar ofertas</label>
      <div class="flex flex-col gap-2 sm:flex-row sm:gap-0">
        <div class="shrink-0">
          <input id="job-status-filter" type="hidden" name="status" value="" />
          <button data-status-trigger type="button" aria-haspopup="menu" aria-expanded="false" aria-controls="job-status-menu" class="inline-flex min-h-12 w-full items-center justify-between gap-3 rounded-lg border border-slate-300 bg-slate-50 px-4 text-left text-base font-medium text-slate-800 hover:bg-slate-100 focus-visible:z-10 focus-visible:outline-2 focus-visible:outline-sky-600 dark:border-slate-600 dark:bg-slate-800 dark:text-white dark:hover:bg-slate-700 sm:w-auto sm:rounded-e-none">
            <span data-status-label>Todos los estados</span><svg aria-hidden="true" class="h-4 w-4 shrink-0" fill="none" viewBox="0 0 24 24"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m19 9-7 7-7-7"/></svg>
          </button>
          <div id="job-status-menu" data-status-menu class="z-40 hidden w-52 rounded-lg border border-slate-200 bg-white p-2 shadow-lg dark:border-slate-700 dark:bg-slate-900">
            <ul role="menu" aria-label="Filtrar por estado">
              {[['','Todos los estados'],['DRAFT','Borrador'],['PUBLISHED','Publicada'],['CLOSED','Cerrada']].map(([value,label]) => <li role="none"><button type="button" role="menuitemradio" tabindex="-1" aria-checked={value === '' ? 'true' : 'false'} data-status-value={value} class="flex min-h-11 w-full items-center rounded-md px-3 text-left text-base text-slate-800 hover:bg-slate-100 focus-visible:outline-2 focus-visible:outline-sky-600 dark:text-slate-100 dark:hover:bg-slate-800">{label}</button></li>)}
            </ul>
          </div>
        </div>
        <div class="relative min-w-0 flex-1">
          <svg aria-hidden="true" class="pointer-events-none absolute inset-y-0 start-3 my-auto h-5 w-5 text-slate-500 dark:text-slate-400" fill="none" viewBox="0 0 24 24"><path stroke="currentColor" stroke-linecap="round" stroke-width="2" d="m21 21-3.5-3.5M17 10a7 7 0 1 1-14 0 7 7 0 0 1 14 0Z"/></svg>
          <input id="job-search" name="q" type="search" maxlength="180" class="q-input w-full ps-11 sm:rounded-none sm:border-x-0" placeholder="Cargo, ubicación o número" />
        </div>
        <button type="submit" class="q-primary shrink-0 sm:rounded-s-none">Buscar</button>
      </div>
      <button data-reset-search type="button" class="q-link" hidden>Limpiar filtros</button>
    </form> : <form data-job-search data-job-list-control role="search" class="flex flex-wrap items-end gap-3" hidden>
      <div class="min-w-0 flex-1 basis-64 space-y-2"><label for="job-search" class="block font-medium">Buscar ofertas</label><input id="job-search" name="q" type="search" maxlength="180" class="q-input" placeholder="Cargo o ubicación" /></div>
      <button type="submit" class="q-primary">Buscar</button>
      <button data-reset-search type="button" class="q-secondary" hidden>Limpiar filtros</button>
    </form>}
    <p data-job-count data-job-list-control role="status" class="text-slate-600 dark:text-slate-300" hidden></p>
    <div data-job-list-loading role="status" class="space-y-4"><span class="sr-only">Cargando ofertas</span>{[1,2,3].map(() => <div aria-hidden="true" class="h-24 animate-pulse rounded-lg bg-slate-200 dark:bg-slate-800"></div>)}</div>
    <div data-job-empty class="py-10" hidden>
      <div class="flex max-w-2xl flex-col items-start gap-5 sm:flex-row sm:items-center">
        <span aria-hidden="true" class="flex h-16 w-16 shrink-0 items-center justify-center rounded-2xl bg-sky-100 text-sky-700 dark:bg-sky-950 dark:text-sky-300"><svg class="h-9 w-9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 7h16v12H4z"/><path d="M9 7V5h6v2M4 12h16M10 12v2h4v-2"/><path d="M17 4v4M15 6h4"/></svg></span>
        <div><h2 data-empty-title class="text-xl font-semibold"></h2><p data-empty-text class="mt-2 max-w-prose text-slate-600 dark:text-slate-300"></p>
        {owned && <a href="/reclutador/nueva-oferta" class="q-primary mt-5 inline-flex items-center">Crear una oferta</a>}</div>
      </div>
    </div>
    <div data-job-list-error class="py-10" role="alert" hidden><div class="flex max-w-3xl flex-col items-start gap-5 sm:flex-row sm:items-center"><span aria-hidden="true" class="flex h-16 w-16 shrink-0 items-center justify-center rounded-2xl bg-red-50 text-red-700 dark:bg-red-950 dark:text-red-200"><svg class="h-9 w-9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="4" width="18" height="14" rx="2"/><path d="M8 22h8M12 18v4M12 7v4M12 14h.01"/></svg></span><div><h2 class="text-xl font-semibold text-red-800 dark:text-red-200">Ups, algo salió mal</h2><p data-job-list-error-text class="mt-2 max-w-prose text-slate-600 dark:text-slate-300">La lista no está disponible ahora. Intenta cargarla de nuevo o revisa tu conexión a internet.</p><button data-job-list-retry type="button" class="q-primary mt-5">Intentar de nuevo</button></div></div></div>
    {owned ? <div data-job-list-control hidden>
      <p class="mb-2 text-sm text-slate-600 dark:text-slate-300 lg:hidden">Desliza horizontalmente para ver todas las columnas.</p>
      <div class="overflow-x-auto rounded-lg border border-slate-200 dark:border-slate-700" tabindex="0" role="region" aria-label="Tabla de ofertas; desplazamiento horizontal">
        <table class="w-full min-w-[720px] text-left text-base text-slate-700 dark:text-slate-200"><caption class="sr-only">Mis ofertas de empleo</caption>
          <thead class="bg-slate-100 text-sm font-semibold text-slate-700 dark:bg-slate-800 dark:text-slate-200"><tr><th scope="col" class="px-4 py-3">Oferta</th><th scope="col" class="px-4 py-3">Estado</th><th scope="col" class="px-4 py-3">Postulantes</th><th scope="col" class="px-4 py-3">Publicación</th><th scope="col" class="px-4 py-3">Acciones</th></tr></thead>
          <tbody data-job-list class="divide-y divide-slate-200 dark:divide-slate-700"></tbody>
        </table>
      </div>
    </div> : <ul data-job-list data-job-list-control class="grid gap-5 xl:grid-cols-2" hidden></ul>}
    <div data-action-menus></div>
    <nav data-job-pagination data-job-list-control aria-label="Páginas de ofertas" class="flex flex-wrap items-center justify-between gap-3 border-t border-slate-200 pt-5 dark:border-slate-700" hidden>
      <button data-page-prev type="button" class="q-secondary">Anterior</button><span data-page-label class="tabular-nums"></span><button data-page-next type="button" class="q-secondary">Siguiente</button>
    </nav>
  </section>
</div>
<template data-job-row-template>
  <tr class="bg-white hover:bg-slate-50 dark:bg-slate-900 dark:hover:bg-slate-800/60">
    <th scope="row" class="min-w-64 px-4 py-4 font-normal"><a data-job-link class="q-link min-h-11 break-words text-left no-underline"></a><p data-job-meta class="break-words text-sm text-slate-600 dark:text-slate-300"></p></th>
    <td class="px-4 py-4"><span data-job-status class="q-job-badge"></span></td>
    <td class="px-4 py-4 tabular-nums"><span data-job-applicant-count></span></td>
    <td class="whitespace-nowrap px-4 py-4"><span data-job-date></span></td>
    <td class="px-4 py-4"><button data-actions-trigger type="button" aria-haspopup="menu" aria-expanded="false" class="q-secondary inline-flex items-center gap-2">Acciones<svg aria-hidden="true" class="h-4 w-4" fill="none" viewBox="0 0 24 24"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m19 9-7 7-7-7"/></svg></button></td>
  </tr>
</template>
<template data-action-menu-template>
  <div data-action-menu class="z-50 hidden w-52 rounded-lg border border-slate-200 bg-white p-2 shadow-lg dark:border-slate-700 dark:bg-slate-900">
    <ul role="menu" aria-label="Acciones de la oferta">
      <li role="none"><a data-job-edit role="menuitem" tabindex="-1" class="flex min-h-11 items-center rounded-md px-3 font-medium text-slate-800 hover:bg-slate-100 focus-visible:outline-2 focus-visible:outline-sky-600 dark:text-slate-100 dark:hover:bg-slate-800">Gestionar oferta</a></li>
      <li role="none"><a data-job-applicants role="menuitem" tabindex="-1" class="flex min-h-11 items-center rounded-md px-3 font-medium text-slate-800 hover:bg-slate-100 focus-visible:outline-2 focus-visible:outline-sky-600 dark:text-slate-100 dark:hover:bg-slate-800">Ver currículums</a></li>
      <li role="none"><button data-job-close-action role="menuitem" tabindex="-1" type="button" class="flex min-h-11 w-full items-center rounded-md px-3 text-left font-medium text-slate-800 hover:bg-slate-100 focus-visible:outline-2 focus-visible:outline-sky-600 dark:text-slate-100 dark:hover:bg-slate-800">Cerrar oferta</button></li>
      <li role="none"><button data-job-delete-action role="menuitem" tabindex="-1" type="button" class="flex min-h-11 w-full items-center rounded-md px-3 text-left font-medium text-red-700 hover:bg-red-50 focus-visible:outline-2 focus-visible:outline-sky-600 dark:text-red-300 dark:hover:bg-slate-800">Eliminar oferta</button></li>
    </ul>
  </div>
</template>
<template data-job-card-template>
  <li class="flex min-w-0 flex-col rounded-xl bg-white p-5 shadow-md ring-1 ring-slate-200 motion-safe:transition-[transform,box-shadow] motion-safe:duration-200 hover:shadow-lg hover:ring-sky-400 motion-safe:hover:-translate-y-0.5 dark:bg-slate-900 dark:ring-slate-700 dark:hover:ring-sky-500 sm:p-6">
    <div class="flex items-start gap-4">
      <span aria-hidden="true" class="flex h-12 w-12 shrink-0 items-center justify-center rounded-lg bg-slate-100 text-slate-600 dark:bg-slate-800 dark:text-slate-300"><svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path stroke-linecap="round" stroke-linejoin="round" d="M4 21V3h12v18M16 9h4v12M2 21h20M8 7h4M8 11h4M8 15h4M8 21v-3h4v3"/></svg></span>
      <div class="min-w-0 flex-1"><h3 class="text-xl font-bold text-slate-900 dark:text-white"><a data-job-link class="inline-flex min-h-11 items-center break-words hover:text-sky-700 hover:underline dark:hover:text-sky-300"></a></h3><p data-job-area class="mt-1 text-sm text-slate-600 dark:text-slate-300"></p></div>
    </div>
    <div class="mt-4 flex flex-wrap gap-2">
      <span data-job-modality class="rounded-md bg-sky-100 px-2.5 py-1 text-sm font-medium text-sky-800 dark:bg-sky-950 dark:text-sky-200" hidden></span>
      <span data-job-location class="rounded-md bg-slate-100 px-2.5 py-1 text-sm font-medium text-slate-700 dark:bg-slate-800 dark:text-slate-200"></span>
    </div>
    <p data-job-description class="my-5 line-clamp-2 leading-relaxed text-slate-600 dark:text-slate-300"></p>
    <div class="mt-auto flex flex-wrap items-center justify-between gap-3 border-t border-slate-100 pt-4 dark:border-slate-800">
      <p class="text-sm text-slate-500 dark:text-slate-400"><span class="block">Publicado el</span><span data-job-date></span></p>
      <a data-job-view class="q-primary inline-flex items-center justify-center gap-2">Ver oferta<svg aria-hidden="true" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 12h16m-6-6 6 6-6 6"/></svg></a>
    </div>
  </li>
</template>

{owned && <dialog data-job-confirm aria-labelledby="job-confirm-title" aria-describedby="job-confirm-text" class="m-auto w-[calc(100%-2rem)] max-w-lg rounded-xl bg-white p-6 text-slate-900 shadow-xl backdrop:bg-slate-950/60 dark:bg-slate-900 dark:text-white">
  <h2 id="job-confirm-title" class="text-xl font-semibold"></h2><p id="job-confirm-text" class="my-5 break-words leading-relaxed"></p>
  <form method="dialog" class="flex flex-wrap gap-3"><button value="cancel" class="q-secondary" autofocus>Cancelar</button><button data-job-confirm-action value="confirm" class="q-primary">Confirmar</button></form>
</dialog>}
