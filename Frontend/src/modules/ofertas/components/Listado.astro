---
interface Props { owned: boolean }
const { owned } = Astro.props;
---
<div class="space-y-6">
  {!owned && <section class="rounded-xl bg-sky-900 p-6 text-white sm:p-8">
    <h2 class="text-2xl font-semibold">Tu próximo capítulo empieza con tu talento.</h2>
    <p class="mt-3 max-w-prose leading-relaxed text-sky-100">Explora las oportunidades y conoce lo que busca cada equipo.</p>
  </section>}
  <section class:list={['space-y-5', { 'q-card p-4 sm:p-6': owned }]} aria-label={owned ? 'Tus ofertas de empleo' : 'Oportunidades abiertas'}>
    <form data-job-search data-job-list-control role="search" class="flex flex-wrap items-end gap-3" hidden>
      <div class="min-w-0 flex-1 basis-64 space-y-2">
        <label for="job-search" class="block font-medium">Buscar ofertas</label>
        <input id="job-search" name="q" type="search" maxlength="180" class="q-input" placeholder={owned ? 'Cargo, ubicación o código' : 'Cargo o ubicación'} />
      </div>
      {owned && <div class="min-w-0 space-y-2">
        <label for="job-status-filter" class="block font-medium">Estado</label>
        <select id="job-status-filter" name="status" class="q-input"><option value="">Todos</option><option value="DRAFT">Borrador</option><option value="PUBLISHED">Publicada</option><option value="CLOSED">Cerrada</option></select>
      </div>}
      <button type="submit" class="q-primary">Buscar</button>
      <button data-reset-search type="button" class="q-secondary" hidden>Limpiar filtros</button>
    </form>
    <p data-job-count data-job-list-control role="status" class="text-slate-600 dark:text-slate-300" hidden></p>
    <div data-job-list-loading role="status" class="space-y-4"><span class="sr-only">Cargando ofertas</span>{[1,2,3].map(() => <div aria-hidden="true" class="h-24 animate-pulse rounded-lg bg-slate-200 dark:bg-slate-800"></div>)}</div>
    <div data-job-empty class="py-10" hidden>
      <div class="flex max-w-2xl flex-col items-start gap-5 sm:flex-row sm:items-center">
        <span aria-hidden="true" class="flex h-16 w-16 shrink-0 items-center justify-center rounded-2xl bg-sky-100 text-sky-700 dark:bg-sky-950 dark:text-sky-300"><svg class="h-9 w-9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 7h16v12H4z"/><path d="M9 7V5h6v2M4 12h16M10 12v2h4v-2"/><path d="M17 4v4M15 6h4"/></svg></span>
        <div><h2 data-empty-title class="text-xl font-semibold"></h2><p data-empty-text class="mt-2 max-w-prose text-slate-600 dark:text-slate-300"></p>
        {owned && <a href="/reclutador/nueva-oferta" class="q-primary mt-5 inline-flex items-center">Crear una oferta</a>}</div>
      </div>
    </div>
    {owned && <div data-list-heading data-job-list-control aria-hidden="true" class="q-job-row hidden border-b border-slate-200 pb-3 font-medium text-slate-600 dark:border-slate-700 dark:text-slate-300 xl:grid"><span>Oferta</span><span>Estado</span><span>Publicación</span><span>Acciones</span></div>}
    <div data-job-list-error class="py-10" role="alert" hidden><div class="flex max-w-3xl flex-col items-start gap-5 sm:flex-row sm:items-center"><span aria-hidden="true" class="flex h-16 w-16 shrink-0 items-center justify-center rounded-2xl bg-red-50 text-red-700 dark:bg-red-950 dark:text-red-200"><svg class="h-9 w-9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="4" width="18" height="14" rx="2"/><path d="M8 22h8M12 18v4M12 7v4M12 14h.01"/></svg></span><div><h2 class="text-xl font-semibold text-red-800 dark:text-red-200">Ups, algo salió mal</h2><p data-job-list-error-text class="mt-2 max-w-prose text-slate-600 dark:text-slate-300">La lista no está disponible ahora. Intenta cargarla de nuevo o revisa tu conexión a internet.</p><button data-job-list-retry type="button" class="q-primary mt-5">Intentar de nuevo</button></div></div></div>
    <ul data-job-list data-job-list-control class:list={[owned ? 'divide-y divide-slate-200 dark:divide-slate-700' : 'grid gap-5 xl:grid-cols-2']} hidden></ul>
    <nav data-job-pagination data-job-list-control aria-label="Páginas de ofertas" class="flex flex-wrap items-center justify-between gap-3 border-t border-slate-200 pt-5 dark:border-slate-700" hidden>
      <button data-page-prev type="button" class="q-secondary">Anterior</button><span data-page-label class="tabular-nums"></span><button data-page-next type="button" class="q-secondary">Siguiente</button>
    </nav>
  </section>
</div>
<template data-job-row-template>
  <li class="q-job-row py-5">
    <div class="min-w-0"><h2 class="font-semibold"><a data-job-link class="q-link break-words no-underline"></a></h2><p data-job-meta class="break-words text-slate-600 dark:text-slate-300"></p></div>
    <div><span data-job-status class="q-job-badge"></span></div>
    <p data-job-date class="text-slate-600 dark:text-slate-300"></p>
    <div class="flex flex-wrap gap-2"><a data-job-edit class="q-secondary inline-flex items-center justify-center justify-self-start">Gestionar</a><a data-job-applicants class="q-link">Ver currículums</a></div>
  </li>
</template>
<template data-job-card-template>
  <li class="q-card flex min-w-0 flex-col p-6">
    <div class="flex flex-wrap items-center justify-between gap-3"><span data-job-area class="q-job-badge" data-status="DRAFT"></span><span data-job-code class="text-slate-600 dark:text-slate-300"></span></div>
    <h3 class="mt-3 text-xl font-semibold"><a data-job-link class="inline-flex min-h-11 items-center break-words hover:underline"></a></h3>
    <p data-job-location class="mt-2 text-slate-600 dark:text-slate-300"></p>
    <p data-job-description class="my-4 line-clamp-3 break-words leading-relaxed"></p>
    <div class="mt-auto flex flex-wrap items-center justify-between gap-3"><p data-job-date class="text-slate-600 dark:text-slate-300"></p><a data-job-view class="q-link">Ver oferta</a></div>
  </li>
</template>
