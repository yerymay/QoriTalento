---
import Panel from '../../compartido/components/ui/Panel.astro';
import Alert from '../../compartido/components/ui/Alert.astro';
import EmptyState from '../../compartido/components/ui/EmptyState.astro';
import Skeleton from '../../compartido/components/ui/Skeleton.astro';
import Badge from '../../compartido/components/ui/Badge.astro';
import Button from '../../compartido/components/ui/Button.astro';
interface Props { owned: boolean }
const { owned } = Astro.props;
const Content = owned ? Panel : 'div';
import VozInline from '../../compartido/components/VozInline.astro';
---
<div class="space-y-6">
  <section class="space-y-5" aria-label={owned ? 'Tus ofertas de empleo' : 'Oportunidades abiertas'}>
    {owned ? <form data-job-search data-job-list-control role="search" class="space-y-4" hidden>
  <div class="relative max-w-xl"><label for="job-search" class="sr-only">Buscar ofertas</label>
    <svg class="ui-icon pointer-events-none absolute left-3 top-3.5 text-slate-600 dark:text-slate-300" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor"><circle cx="10" cy="10" r="6"/><path d="m15 15 6 6"/></svg>
    <input id="job-search" name="q" type="search" maxlength="180" class="q-input bg-panel ps-11" placeholder="Buscar por cargo, ubicación o número" />
  </div>
  <div class="flex flex-wrap items-center gap-2"><input type="hidden" name="status" value="" />
    <div role="group" aria-label="Filtrar ofertas por estado" class="flex flex-wrap gap-2">
      {[['','Todas'],['PUBLISHED','Publicadas'],['DRAFT','Borradores'],['CLOSED','Cerradas']].map(([value,label])=><button type="button" data-status-chip={value} aria-pressed={value===''?'true':'false'} class="job-filter-chip">{label}</button>)}
    </div>
    <Button variant="ghost" data-reset-search type="button" hidden>Limpiar filtros</Button>
  </div>
</form> : <form data-job-search data-job-list-control role="search" class="flex flex-wrap items-center gap-3" hidden>
      <div class="relative min-w-0 max-w-2xl flex-1 basis-64"><label for="job-search" class="sr-only">Buscar ofertas</label><svg class="ui-icon pointer-events-none absolute left-3 top-3.5 text-slate-600 dark:text-slate-300" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor"><circle cx="10" cy="10" r="6"/><path d="m15 15 6 6"/></svg><input id="job-search" name="q" type="search" maxlength="180" class="q-input !pr-14 !pl-11" placeholder="Busca por cargo o ubicación" /><Button variant="icon" data-search-mic type="button" aria-label="Buscar por voz" aria-controls="job-search" aria-pressed="false" class="absolute right-0.5 top-0.5"><svg class="ui-icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor"><rect x="9" y="3" width="6" height="11" rx="3"/><path d="M5 11a7 7 0 0 0 14 0M12 18v3"/></svg></Button></div>
      <Button variant="ghost" data-reset-search type="button" hidden>Limpiar filtros</Button>
    </form>}

    {!owned && <VozInline nombre="buscador" />}




    {!owned && <p data-job-count data-job-list-control role="status" class="text-slate-600 dark:text-slate-300" hidden></p>}
    <Content class:list={["space-y-5",{"py-5":owned}]} data-job-results>
    <div data-job-list-loading role="status" class="space-y-4"><span class="sr-only"><span data-i18n="revisado.19148f018bd24254">Cargando ofertas</span></span><Skeleton heights={["6rem","6rem","6rem"]} announce={false} /></div>
    <EmptyState data-job-empty align={owned ? "center" : "start"} class="py-10" hidden>
        <span slot="icon" aria-hidden="true" class="flex h-16 w-16 shrink-0 items-center justify-center rounded-2xl bg-sky-100 text-sky-700 dark:bg-sky-950 dark:text-sky-300"><svg class="h-9 w-9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 7h16v12H4z"/><path d="M9 7V5h6v2M4 12h16M10 12v2h4v-2"/><path d="M17 4v4M15 6h4"/></svg></span>
        <h2 slot="title" data-empty-title class="text-xl font-semibold"></h2><p slot="description" data-empty-text class="mt-2 max-w-prose text-slate-600 dark:text-slate-300"></p>
        {owned && <><Button as="a" variant="primary" data-empty-create href="/reclutador/nueva-oferta">Crear oferta</Button><Button variant="secondary" data-empty-reset type="button" hidden>Limpiar filtros</Button></>}
    </EmptyState>
    <Alert data-job-list-error tone="error" title="No se pudieron cargar tus ofertas" class="mx-5" hidden><p data-job-list-error-text>Revisa tu conexión e intenta de nuevo.</p><Button slot="action" variant="secondary" data-job-list-retry type="button">Reintentar</Button></Alert>
    {owned ? <div data-job-list-control hidden>
      <p class="px-5 text-sm text-slate-600 dark:text-slate-300 lg:hidden">Desliza horizontalmente para ver todas las columnas.</p>
      <div class="relative overflow-x-auto" tabindex="0" role="region" aria-label="Tabla de ofertas; desplazamiento horizontal">
        <table class="w-full min-w-[760px] text-left text-base text-slate-700 dark:text-slate-200"><caption class="sr-only">Mis ofertas de empleo</caption>
          <thead class="bg-slate-100 text-sm font-semibold text-slate-700 dark:bg-slate-800 dark:text-slate-200"><tr><th scope="col" class="px-4 py-3">Oferta</th><th scope="col" class="px-4 py-3">Estado</th><th scope="col" class="px-4 py-3 text-right">Postulantes</th><th scope="col" class="px-4 py-3">Publicación</th><th scope="col" class="px-4 py-3"><span class="sr-only">Opciones de la oferta</span></th></tr></thead>
          <tbody data-job-list class="divide-y divide-slate-200 dark:divide-slate-700"></tbody>
        </table>
      </div>
    </div> : <ul data-job-list data-job-list-control class="grid gap-5 xl:grid-cols-2" hidden></ul>}
    <div data-action-menus></div>
    {owned && <p data-job-count role="status" class="px-5 text-sm text-slate-600 dark:text-slate-300"></p>}
    <nav data-job-pagination data-job-list-control aria-label="Páginas de ofertas" class="flex flex-wrap items-center justify-between gap-3 border-t border-slate-200 px-5 pt-5 dark:border-slate-700" hidden>
      <Button variant="secondary" data-page-prev type="button" class="ui-button--secondary"><span data-i18n="revisado.e4ce7c09d51e3b88">Anterior</span></Button><span data-page-label class="tabular-nums"></span><Button variant="secondary" data-page-next type="button" class="ui-button--secondary" data-i18n="texto.U2lndWllbnRl">Siguiente</Button>
    </nav>
    </Content>
  </section>
</div>
<template data-job-row-template>
  <tr class="job-table-row">
    <th scope="row" class="px-5 py-4 text-left font-normal"><a data-job-link class="inline-flex min-h-11 items-center font-semibold text-slate-900 hover:text-sky-700 hover:underline focus-visible:outline-2 focus-visible:outline-sky-600 dark:text-white dark:hover:text-sky-300"></a><p data-job-meta class="text-sm text-slate-600 dark:text-slate-300"></p><p data-job-completeness class="mt-1 text-sm text-amber-900 dark:text-amber-200" hidden></p></th>
    <td class="px-4 py-4"><Badge data-job-status /></td>
    <td class="px-4 py-4 text-right tabular-nums"><span data-job-applicant-count></span></td>
    <td class="whitespace-nowrap px-4 py-4 text-sm"><span data-job-date></span></td>
    <td class="px-4 py-4"><div class="flex items-center justify-end gap-2">
      <Button as="a" variant="ghost" data-job-quick class="job-quick-action"><svg class="ui-icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="m15 4 5 5M4 20l5-1L20 8a2 2 0 0 0-5-5L4 14z"/></svg><span class="sr-only">Gestionar oferta</span></Button>
      <Button variant="icon" data-actions-trigger type="button" aria-label="Más opciones" aria-haspopup="menu" aria-expanded="false"><svg class="ui-icon" aria-hidden="true" viewBox="0 0 24 24" fill="currentColor"><circle cx="5" cy="12" r="1.5"/><circle cx="12" cy="12" r="1.5"/><circle cx="19" cy="12" r="1.5"/></svg></Button>
    </div></td>
  </tr>
</template>
<template data-action-menu-template>
  <div data-action-menu class="ui-menu-surface z-50 hidden w-52 p-2">
    <ul data-i18n-aria-label="revisado.5e923222fe0a0108" role="menu" aria-label="Acciones de la oferta">
      <li role="none"><a data-job-edit role="menuitem" tabindex="-1" class="flex min-h-11 items-center rounded-md px-3 font-medium text-slate-800 hover:bg-slate-100 focus-visible:outline-2 focus-visible:outline-sky-600 dark:text-slate-100 dark:hover:bg-slate-800"><span data-i18n="revisado.47e2e3bb25299db7">Gestionar oferta</span></a></li>
      <li role="none"><a data-job-applicants role="menuitem" tabindex="-1" class="flex min-h-11 items-center rounded-md px-3 font-medium text-slate-800 hover:bg-slate-100 focus-visible:outline-2 focus-visible:outline-sky-600 dark:text-slate-100 dark:hover:bg-slate-800"><span data-i18n="revisado.fbfd462fd655468c">Ver currículums</span></a></li>
      <li role="none"><a data-job-exams role="menuitem" tabindex="-1" class="flex min-h-11 items-center rounded-md px-3 font-medium text-slate-800 hover:bg-slate-100 focus-visible:outline-2 focus-visible:outline-sky-600 dark:text-slate-100 dark:hover:bg-slate-800" data-i18n="texto.UHJ1ZWJhcyB0P2NuaWNhcw">Pruebas técnicas</a></li>
      <li role="none"><button data-job-close-action role="menuitem" tabindex="-1" type="button" class="flex min-h-11 w-full items-center rounded-md px-3 text-left font-medium text-slate-800 hover:bg-slate-100 focus-visible:outline-2 focus-visible:outline-sky-600 dark:text-slate-100 dark:hover:bg-slate-800" data-i18n="texto.Q2VycmFyIG9mZXJ0YQ">Cerrar oferta</button></li>
      <li role="none"><button data-job-delete-action role="menuitem" tabindex="-1" type="button" class="flex min-h-11 w-full items-center rounded-md px-3 text-left font-medium text-red-700 hover:bg-red-50 focus-visible:outline-2 focus-visible:outline-sky-600 dark:text-red-300 dark:hover:bg-slate-800"><span data-i18n="revisado.cdd3bed473b2a318">Eliminar oferta</span></button></li>
    </ul>
  </div>
</template>
<template data-job-card-template>
  <li class="ui-panel flex min-w-0 flex-col p-5 sm:p-6">
    <div class="flex items-start gap-4">
      <span aria-hidden="true" class="flex h-12 w-12 shrink-0 items-center justify-center rounded-lg bg-slate-100 text-slate-600 dark:bg-slate-800 dark:text-slate-300"><svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path stroke-linecap="round" stroke-linejoin="round" d="M4 21V3h12v18M16 9h4v12M2 21h20M8 7h4M8 11h4M8 15h4M8 21v-3h4v3"/></svg></span>
      <div class="min-w-0 flex-1"><h3 class="text-xl font-bold text-slate-900 dark:text-white"><a data-job-link class="inline-flex min-h-11 items-center break-words hover:text-sky-700 hover:underline dark:hover:text-sky-300"></a></h3><p data-job-area class="mt-1 text-sm text-slate-600 dark:text-slate-300"></p></div>
    </div>
    <div class="mt-4 flex flex-wrap gap-2">
      <span data-job-modality class="rounded-md bg-sky-100 px-2.5 py-1 text-sm font-medium text-sky-800 dark:bg-sky-950 dark:text-sky-200" hidden></span>
      <span data-job-location class="rounded-md bg-slate-100 px-2.5 py-1 text-sm font-medium text-slate-700 dark:bg-slate-800 dark:text-slate-200"></span>
    </div>
    <p data-job-description class="my-5 line-clamp-2 leading-relaxed text-slate-600 dark:text-slate-300"></p>
    <div class="mt-auto flex flex-wrap items-center justify-between gap-3 border-t border-slate-100 pt-4 dark:border-slate-800">
      <p class="text-sm text-slate-600 dark:text-slate-300"><span class="block"><span data-i18n="revisado.577de21ac86498ee">Publicado el</span></span><span data-job-date></span></p>
      <Button as="a" variant="primary" data-job-view class="ui-button--primary inline-flex items-center justify-center gap-2"><span data-i18n="revisado.ed4e58cda574616d">Ver oferta</span><svg aria-hidden="true" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 12h16m-6-6 6 6-6 6"/></svg></Button>
    </div>
  </li>
</template>

{owned && <dialog data-job-confirm aria-labelledby="job-confirm-title" aria-describedby="job-confirm-text" class="m-auto w-[calc(100%-2rem)] max-w-lg rounded-xl bg-white p-6 text-slate-900 shadow-xl backdrop:bg-slate-950/60 dark:bg-slate-900 dark:text-white">
  <h2 id="job-confirm-title" class="text-xl font-semibold"></h2><p id="job-confirm-text" class="my-5 break-words leading-relaxed"></p>
  <form method="dialog" class="flex flex-wrap gap-3"><Button variant="secondary" type="submit" value="cancel" class="ui-button--secondary" autofocus data-i18n="texto.Q2FuY2VsYXI">Cancelar</Button><Button variant="primary" type="submit" data-job-confirm-action value="confirm" class="ui-button--primary" data-i18n="texto.Q29uZmlybWFy">Confirmar</Button></form>
</dialog>}

<script>import { initVozBuscador } from '../voz-buscador'; initVozBuscador();</script>
