---
import Button from '../../compartido/components/ui/Button.astro';
interface Props {field:string;label:string}
const {field,label}=Astro.props;
---
<Button variant="icon" type="button" data-field-voice={field} aria-label={'Dictar '+label} title={'Dictar '+label} aria-controls={field} aria-pressed="false" class="job-field-mic">
  <svg class="ui-icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor"><rect x="9" y="3" width="6" height="11" rx="3"/><path d="M5 11a7 7 0 0 0 14 0M12 18v3"/></svg>
</Button>
