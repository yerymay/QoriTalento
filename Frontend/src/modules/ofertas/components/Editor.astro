---
import Badge from '../../compartido/components/ui/Badge.astro';
import Button from '../../compartido/components/ui/Button.astro';
import Panel from '../../compartido/components/ui/Panel.astro';
import VozCampo from './VozCampo.astro';
import VozOferta from './VozOferta.astro';
import Stepper from '../../compartido/components/Stepper.astro';
interface Props { wizard?:boolean }
const {wizard=false}=Astro.props;
const textareas=[
  {id:'description',label:'Descripción del puesto',rows:6,max:10000,placeholder:'Describe brevemente el puesto y el equipo.',help:'Hasta 10 000 caracteres.'},
  {id:'responsibilities',label:'Funciones principales (opcional)',rows:4,max:50049,placeholder:'Una función por línea',help:'Hasta 50 funciones de 1000 caracteres cada una.'},
  {id:'requirements',label:'Requisitos y habilidades',rows:4,max:50049,placeholder:'Escribe un requisito por línea',help:'Hasta 50 requisitos de 1000 caracteres cada uno.'},
  {id:'experience_required',label:'Experiencia requerida (opcional)',rows:3,max:2000,placeholder:'Ej. Dos años en proyectos digitales',help:''},
  {id:'education_required',label:'Formación académica (opcional)',rows:3,max:2000,placeholder:'Ej. Estudios técnicos o universitarios',help:''},
];
---
<div data-job-editor hidden class="space-y-5">
  <VozOferta />
  <form data-job-form class="ui-panel p-5 sm:p-7" novalidate={wizard}>
    {wizard && <div class="mb-7 border-b border-slate-200 pb-6 dark:border-slate-700">
      <Stepper kind="oferta" label="Pasos de la oferta" labels={['Datos del puesto','Descripción y requisitos','Condiciones','Revisión']} />
      <div class="mt-5 flex items-center gap-3"><progress data-offer-progress value="0" max="4" aria-label="Secciones completadas" class="h-2 min-w-0 flex-1 accent-sky-700"></progress><p data-offer-progress-text role="status" class="text-sm text-slate-600 dark:text-slate-300"></p></div>
    </div>}
    <fieldset data-job-fields class="min-w-0 space-y-6">
      {wizard && <div data-wizard-heading tabindex="-1" class="space-y-1 focus:outline-none"><h2 data-wizard-title class="text-xl font-semibold"></h2><p data-wizard-help class="text-slate-600 dark:text-slate-300"></p></div>}
      <div class:list={['flex flex-wrap items-start justify-between gap-4',{hidden:wizard}]}><div><h2 class="text-xl font-semibold">Información de la oferta</h2><p class="mt-1 text-sm text-slate-600 dark:text-slate-300">Completa los datos del puesto y guarda tu avance. Los campos con * son obligatorios.</p></div><Badge data-editor-status data-status="DRAFT">Borrador</Badge></div>
      <div data-wizard-step="0" class="grid gap-5 md:grid-cols-2">
        <div class="space-y-2"><label for="title" class="block font-medium">Cargo *</label><div class="job-voice-field"><input id="title" name="title" required minlength="1" maxlength="180" placeholder="Ej. Diseñador de producto" class="q-input pr-14" /><VozCampo field="title" label="el cargo" /></div></div>
        {[{id:'area',label:'Área (opcional)',options:['Tecnología','Producto & Diseño','Marketing','Recursos Humanos','Finanzas']},{id:'modality',label:'Modalidad (opcional)',options:['Remoto','Presencial','Híbrido']}].map(field=><div class="space-y-2"><label id={field.id+'-label'} class="block font-medium">{field.label}</label><div data-editor-dropdown class="relative"><select id={field.id} name={field.id} hidden><option value="">Selecciona una opción</option>{field.options.map(option=><option>{option}</option>)}</select><button type="button" data-editor-dropdown-trigger aria-haspopup="menu" aria-expanded="false" class="q-input !flex items-center justify-between gap-3 !pr-16 text-left"><span data-editor-dropdown-label></span><svg class="ui-icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="m7 10 5 5 5-5"/></svg></button><VozCampo field={field.id} label={field.label.toLowerCase().replace(' (opcional)','')} /><div data-editor-dropdown-menu class="ui-menu-surface z-40 hidden min-w-52 p-2"><ul role="menu"></ul></div></div></div>)}
        <div class="space-y-2"><label for="location" class="block font-medium">Ubicación (opcional)</label><div class="job-voice-field"><input id="location" name="location" maxlength="180" list="job-cities" placeholder="Ej. Lima, Perú" class="q-input pr-14" /><VozCampo field="location" label="la ubicación" /></div><datalist id="job-cities"><option value="Lima, Perú"/><option value="Abancay, Perú"/><option value="Cusco, Perú"/><option value="Arequipa, Perú"/></datalist></div>
      </div>
      <div data-wizard-step="1" class="space-y-5">
        {textareas.map(field=><div class="space-y-2"><label for={field.id} class="block font-medium">{field.label}</label>
          {field.id==='description'&&<div class="flex gap-1" role="group" aria-label="Formato de descripción">{[['bold','Insertar marcas de negrita','N'],['italic','Insertar marcas de cursiva','I'],['list','Insertar viñeta','Lista']].map(([format,label,text])=><Button variant="ghost" type="button" data-description-format={format} aria-label={label}>{text}</Button>)}</div>}
          <div class="job-voice-field"><textarea id={field.id} name={field.id} rows={field.rows} maxlength={field.max} class="q-input pr-14" placeholder={field.placeholder} aria-describedby={field.help?field.id+'-help':undefined}></textarea><VozCampo field={field.id} label={field.label.toLowerCase().replace(' (opcional)','')} /></div>
          {field.help&&<p id={field.id+'-help'} class="text-sm text-slate-600 dark:text-slate-300">{field.help}</p>}
        </div>)}
      </div>
      <div data-wizard-step="2" class="space-y-5">
        <div class="space-y-2"><label for="work_schedule" class="block font-medium">Jornada (opcional)</label><div class="job-voice-field"><input id="work_schedule" name="work_schedule" list="job-schedules" maxlength="120" class="q-input pr-14" placeholder="Ej. Tiempo completo" /><VozCampo field="work_schedule" label="la jornada" /></div><datalist id="job-schedules"><option value="Tiempo completo"/><option value="Medio tiempo"/><option value="Por horas"/></datalist></div>
        <fieldset class="space-y-3"><legend class="font-semibold">Lo que ofrecemos (opcional)</legend><p class="text-sm text-slate-600 dark:text-slate-300">Selecciona solo los beneficios que ofrece este puesto.</p><div class="grid gap-2 sm:grid-cols-2">{['Capacitaciones y desarrollo profesional','Oportunidades de crecimiento','Horario flexible','Seguro de salud','Bonos o incentivos'].map(benefit=><label class="flex min-h-11 items-center gap-3 rounded-lg border border-slate-200 px-3 py-2 dark:border-slate-700"><input type="checkbox" name="benefit" value={benefit} class="h-5 w-5 rounded border-slate-400 text-sky-700 focus:ring-sky-600" /><span>{benefit}</span></label>)}</div><label for="other_benefits" class="block font-medium">Otros beneficios</label><div class="job-voice-field"><textarea id="other_benefits" name="other_benefits" rows="3" class="q-input pr-14" placeholder="Un beneficio por línea"></textarea><VozCampo field="other_benefits" label="otros beneficios" /></div><p class="text-sm text-slate-600 dark:text-slate-300">Hasta 50 beneficios en total, con 1000 caracteres como máximo por beneficio.</p></fieldset>
      </div>
      {wizard&&<section data-wizard-step="3" hidden aria-labelledby="wizard-review-title"><h3 id="wizard-review-title" class="text-xl font-semibold">Revisa tu oferta</h3><p class="mt-2 text-slate-600 dark:text-slate-300">Comprueba la información antes de guardar. Podrás editarla después.</p><dl data-wizard-review class="mt-6 grid gap-4 sm:grid-cols-2"></dl></section>}
      <div data-job-actions class="job-editor-actions">
        {wizard&&<Button variant="ghost" data-wizard-prev type="button" hidden>Anterior</Button>}
        <button data-save-job class:list={[wizard?'ui-button--secondary':'ui-button--primary']} type="submit">Guardar borrador</button>
        {wizard&&<Button variant="primary" data-wizard-next type="button" class="sm:ml-auto">Continuar</Button>}
        <Button variant="secondary" data-discard-job type="button" class:list={[{hidden:wizard}]}>Descartar cambios</Button>
        <p data-dirty-message role="status" tabindex="-1" class="text-slate-600 dark:text-slate-300">Sin cambios pendientes.</p>
      </div>
    </fieldset>
  </form>
  <Panel as="section" data-publication class="ui-panel space-y-4 p-5 sm:p-7" hidden aria-labelledby="publication-title">
    <div class="flex flex-wrap items-center justify-between gap-3"><h2 id="publication-title" class="text-xl font-semibold"><span data-i18n="revisado.ab3b2a4b8c89e2d4">Publicación</span></h2><span data-job-id class="text-slate-600 dark:text-slate-300"></span></div>
    <p data-publication-help class="max-w-prose leading-relaxed text-slate-600 dark:text-slate-300"></p>
    <div class="flex flex-wrap gap-3"><Button variant="primary" data-publish-job type="button" class="ui-button--primary" hidden><span data-i18n="revisado.40f808ded2ec43aa">Publicar oferta</span></Button><Button variant="secondary" data-close-job type="button" class="ui-button--secondary" hidden data-i18n="texto.Q2VycmFyIG9mZXJ0YQ">Cerrar oferta</Button><Button variant="secondary" data-finish-job type="button" class="ui-button--secondary" hidden><span data-i18n="revisado.2908ceb509186c73">Finalizar proceso</span></Button></div>
  </Panel>
</div>
<dialog data-job-confirm aria-labelledby="job-confirm-title" aria-describedby="job-confirm-text" class="q-job-dialog m-auto w-[calc(100%-2rem)] max-w-lg rounded-xl bg-white p-6 text-slate-900 shadow-xl backdrop:bg-slate-950/60 dark:bg-slate-900 dark:text-white">
  <h2 id="job-confirm-title" class="text-xl font-semibold"></h2>
  <p id="job-confirm-text" class="my-5 break-words leading-relaxed"></p>
  <form method="dialog" class="flex flex-wrap gap-3"><Button variant="secondary" type="submit" value="cancel" class="ui-button--secondary" autofocus data-i18n="texto.Q2FuY2VsYXI">Cancelar</Button><Button variant="primary" type="submit" data-job-confirm-action value="confirm" class="ui-button--primary" data-i18n="texto.Q29uZmlybWFy">Confirmar</Button></form>
</dialog>
<script>import { initVozOferta } from '../voz-oferta'; initVozOferta();</script>
