---
import PanelVoz from '../../compartido/components/PanelVoz.astro';
import Stepper from '../../compartido/components/Stepper.astro';
interface Props { wizard?: boolean }
const { wizard = false } = Astro.props;


---
<div data-job-editor hidden class="space-y-5">
  <a href="/reclutador/ofertas" class="q-link" data-i18n="texto.Vm9sdmVyIGEgbWlzIG9mZXJ0YXM">Volver a mis ofertas</a>
  <PanelVoz nombre="oferta" titulo="Completar por voz" textoBoton="Hablar"
  ejemplos={['“Cargo diseñador de producto”', '“Ubicación Lima, Perú”', '“Modalidad remoto”', '“Área tecnología”', '“Requisito experiencia en equipo”', '“Descripción …”', '“Escribir …” (texto en el campo donde estás)']} />

  <div data-individual-note class="q-notice" hidden>Como reclutador particular, puedes crear y publicar todas tus ofertas completas.</div>
  <form data-job-form class="q-card p-5 sm:p-7" novalidate={wizard}>
    {wizard && <div class="mb-7 border-b border-slate-200 pb-6 dark:border-slate-700"><Stepper kind="oferta" label="Pasos de la oferta" labels={['Datos del puesto', 'Descripción y requisitos', 'Condiciones', 'Revisión']} /></div>}
    <fieldset data-job-fields class="min-w-0 space-y-6">
      {wizard && <div data-wizard-heading tabindex="-1" class="space-y-1 focus:outline-none"><h2 data-wizard-title class="text-xl font-semibold"></h2><p data-wizard-help class="leading-relaxed text-slate-600 dark:text-slate-300"></p></div>}
      <div class:list={["flex flex-wrap items-start justify-between gap-4", { hidden: wizard }]}><div><h2 class="text-xl font-semibold" data-i18n="texto.SW5mb3JtYWNpP24gZGUgbGEgb2ZlcnRh">Información de la oferta</h2><p class="mt-1 text-sm leading-6 text-slate-600 dark:text-slate-300" data-i18n="texto.Q29tcGxldGEgbG9zIGRhdG9zIGRlbCBwdWVzdG8geSBndWFyZGEgdHUgYXZhbmNlLiBMb3MgY2FtcG9zIGNvbiAqIHNvbiBvYmxpZ2F0b3Jpb3Mu">Completa los datos del puesto y guarda tu avance. Los campos con * son obligatorios.</p></div><span data-editor-status class="q-job-badge" data-status="DRAFT" data-i18n="texto.Qm9ycmFkb3I">Borrador</span></div>
      <div data-wizard-step="0" class="grid gap-5 md:grid-cols-2">
        <div class="space-y-2"><label for="title" class="block font-medium">Cargo *</label><div class="relative"><svg aria-hidden="true" class="pointer-events-none absolute left-3 top-1/2 h-5 w-5 -translate-y-1/2 text-slate-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M8 7V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2M3 11h18M5 7h14a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V9a2 2 0 0 1 2-2Z"/></svg><input id="title" name="title" required minlength="1" maxlength="180" placeholder="Ej. Diseñador de producto" class="q-input pl-11" /></div></div>
        <div class="space-y-2"><label id="area-label" class="block font-medium">Área (opcional)</label><div data-editor-dropdown class="relative"><select id="area" name="area" hidden><option value="">Selecciona un área</option><option>Tecnología</option><option>Producto &amp; Diseño</option><option>Marketing</option><option>Recursos Humanos</option><option>Finanzas</option></select><button type="button" data-editor-dropdown-trigger aria-haspopup="menu" aria-expanded="false" class="inline-flex min-h-12 w-full items-center justify-between gap-3 rounded-lg border border-slate-300 bg-slate-50 px-4 text-left text-base font-medium text-slate-800 hover:bg-slate-100 focus-visible:outline-2 focus-visible:outline-sky-600 dark:border-slate-600 dark:bg-slate-800 dark:text-white dark:hover:bg-slate-700"><span data-editor-dropdown-label></span><svg aria-hidden="true" class="h-4 w-4 shrink-0" fill="none" viewBox="0 0 24 24"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m19 9-7 7-7-7"/></svg></button><div data-editor-dropdown-menu class="z-40 hidden min-w-52 rounded-lg border border-slate-200 bg-white p-2 shadow-lg dark:border-slate-700 dark:bg-slate-900"><ul role="menu"></ul></div></div></div>
      </div>
      <div data-wizard-step="0" class="grid gap-5 sm:grid-cols-2">
        <div class="space-y-2"><label id="modality-label" class="block font-medium">Modalidad (opcional)</label><div data-editor-dropdown class="relative"><select id="modality" name="modality" hidden><option value="">Selecciona una modalidad</option><option>Remoto</option><option>Presencial</option><option>Híbrido</option></select><button type="button" data-editor-dropdown-trigger aria-haspopup="menu" aria-expanded="false" class="inline-flex min-h-12 w-full items-center justify-between gap-3 rounded-lg border border-slate-300 bg-slate-50 px-4 text-left text-base font-medium text-slate-800 hover:bg-slate-100 focus-visible:outline-2 focus-visible:outline-sky-600 dark:border-slate-600 dark:bg-slate-800 dark:text-white dark:hover:bg-slate-700"><span data-editor-dropdown-label></span><svg aria-hidden="true" class="h-4 w-4 shrink-0" fill="none" viewBox="0 0 24 24"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m19 9-7 7-7-7"/></svg></button><div data-editor-dropdown-menu class="z-40 hidden min-w-52 rounded-lg border border-slate-200 bg-white p-2 shadow-lg dark:border-slate-700 dark:bg-slate-900"><ul role="menu"></ul></div></div></div>
        <div class="space-y-2"><label for="location" class="block font-medium">Ubicación (opcional)</label><input id="location" name="location" maxlength="180" list="job-cities" placeholder="Ej. Lima, Perú" class="q-input" /><datalist id="job-cities"><option value="Lima, Perú"></option><option value="Abancay, Perú"></option><option value="Cusco, Perú"></option><option value="Arequipa, Perú"></option></datalist></div>
      </div>
      <div data-wizard-step="2" class="space-y-2"><label for="work_schedule" class="block font-medium">Jornada (opcional)</label><input id="work_schedule" name="work_schedule" list="job-schedules" maxlength="120" class="q-input" placeholder="Ej. Tiempo completo"/><datalist id="job-schedules"><option value="Tiempo completo"/><option value="Medio tiempo"/><option value="Por horas"/></datalist></div>
      <div data-wizard-step="1" class="space-y-2"><label for="description" class="block font-medium"><span data-i18n="revisado.371dafcc73b56899">Descripción del puesto</span></label><div class="overflow-hidden rounded-lg border border-slate-300 dark:border-slate-600"><div class="flex gap-1 border-b border-slate-200 bg-slate-50 p-2 dark:border-slate-600 dark:bg-slate-800" role="group" aria-label="Formato de descripción"><button type="button" data-description-format="bold" aria-label="Insertar marcas de negrita" title="Negrita" class="min-h-11 min-w-11 rounded-lg font-bold hover:bg-slate-200 dark:hover:bg-slate-700">N</button><button type="button" data-description-format="italic" aria-label="Insertar marcas de cursiva" title="Cursiva" class="min-h-11 min-w-11 rounded-lg italic hover:bg-slate-200 dark:hover:bg-slate-700">I</button><button type="button" data-description-format="list" aria-label="Insertar viñeta" title="Lista" class="min-h-11 min-w-11 rounded-lg hover:bg-slate-200 dark:hover:bg-slate-700">☰</button></div><textarea id="description" name="description" rows="6" maxlength="10000" class="q-input !rounded-none !border-0" placeholder="Describe brevemente el puesto y el equipo." aria-describedby="description-help"></textarea></div><p id="description-help" class="text-sm text-slate-600 dark:text-slate-300">Hasta 10 000 caracteres. Los controles insertan marcas de texto visibles.</p></div>
      <div data-wizard-step="1" class="space-y-2"><label for="responsibilities" class="block font-medium">Funciones principales (opcional)</label><textarea id="responsibilities" name="responsibilities" rows="4" class="q-input" placeholder="Una función por línea&#10;Ej. Atender solicitudes de soporte"></textarea><p class="text-sm text-slate-600 dark:text-slate-300">Escribe una función por línea. Hasta 50 funciones de 1000 caracteres cada una.</p></div>
      <div data-wizard-step="1" class="space-y-2"><label for="requirements" class="block font-medium"><span data-i18n="revisado.cca194a20b46ebd7">Requisitos y habilidades</span></label><textarea id="requirements" name="requirements" rows="4" maxlength="50049" class="q-input" placeholder="Escribe un requisito por línea&#10;Ej. Experiencia trabajando en equipo" aria-describedby="requirements-help"></textarea><p id="requirements-help" class="text-sm text-slate-600 dark:text-slate-300">Un requisito por línea. Hasta 50 requisitos de 1000 caracteres cada uno.</p></div>
      <div data-wizard-step="1" class="grid gap-5 md:grid-cols-2"><div class="space-y-2"><label for="experience_required" class="block font-medium">Experiencia requerida (opcional)</label><textarea id="experience_required" name="experience_required" rows="3" maxlength="2000" class="q-input" placeholder="Ej. Dos años de experiencia en diseño de productos digitales"></textarea></div><div class="space-y-2"><label for="education_required" class="block font-medium">Formación académica (opcional)</label><textarea id="education_required" name="education_required" rows="3" maxlength="2000" class="q-input" placeholder="Ej. Estudios técnicos o universitarios en Diseño"></textarea></div></div>
      <fieldset data-wizard-step="2" class="space-y-3"><legend class="font-semibold">Lo que ofrecemos (opcional)</legend><p class="text-sm text-slate-600 dark:text-slate-300">Selecciona solo los beneficios que ofrece este puesto.</p><div class="grid gap-2 sm:grid-cols-2">{['Capacitaciones y desarrollo profesional','Oportunidades de crecimiento','Horario flexible','Seguro de salud','Bonos o incentivos'].map(benefit => <label class="flex min-h-11 items-center gap-3 rounded-lg border border-slate-200 px-3 py-2 dark:border-slate-700"><input type="checkbox" name="benefit" value={benefit} class="h-5 w-5 rounded border-slate-400 text-sky-700 focus:ring-sky-600"/><span>{benefit}</span></label>)}</div><label for="other_benefits" class="block font-medium">Otros beneficios</label><textarea id="other_benefits" name="other_benefits" rows="3" class="q-input" placeholder="Un beneficio por línea"></textarea><p class="text-sm text-slate-600 dark:text-slate-300">Hasta 50 beneficios en total, con 1000 caracteres como máximo por beneficio.</p></fieldset>
      {wizard && <section data-wizard-step="3" hidden aria-labelledby="wizard-review-title"><h3 id="wizard-review-title" class="text-xl font-semibold">Revisa tu oferta</h3><p class="mt-2 text-slate-600 dark:text-slate-300">Comprueba la información antes de guardar. Podrás editarla después.</p><dl data-wizard-review class="mt-6 grid gap-4 sm:grid-cols-2"></dl></section>}
      <div class="flex flex-wrap items-center gap-3 border-t border-slate-200 pt-5 dark:border-slate-700">
        {wizard && <button data-wizard-prev class="q-secondary inline-flex items-center gap-2" type="button" hidden><svg aria-hidden="true" class="h-4 w-4" fill="none" viewBox="0 0 24 24"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m15 18-6-6 6-6"/></svg>Anterior</button>}
        <button data-save-job class:list={[wizard ? 'q-secondary' : 'q-primary']} type="submit"><span data-i18n="revisado.474b28f85eb284cb">Guardar borrador</span></button>
        {wizard && <button data-wizard-next class="q-primary inline-flex items-center justify-center gap-2 sm:ml-auto" type="button">Continuar<svg aria-hidden="true" class="h-4 w-4" fill="none" viewBox="0 0 24 24"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m9 18 6-6-6-6"/></svg></button>}
        <button data-discard-job class:list={["q-secondary", { hidden: wizard }]} type="button"><span data-i18n="revisado.80ca383e9c8d3e13">Descartar cambios</span></button>
        <p data-dirty-message role="status" class="text-slate-600 dark:text-slate-300"><span data-i18n="revisado.e76fe7689c99e9cc">Sin cambios pendientes.</span></p>
      </div>
    </fieldset>
  </form>
  <section data-publication class="q-card space-y-4 p-5 sm:p-7" hidden aria-labelledby="publication-title">
    <div class="flex flex-wrap items-center justify-between gap-3"><h2 id="publication-title" class="text-xl font-semibold"><span data-i18n="revisado.ab3b2a4b8c89e2d4">Publicación</span></h2><span data-job-id class="text-slate-600 dark:text-slate-300"></span></div>
    <p data-publication-help class="max-w-prose leading-relaxed text-slate-600 dark:text-slate-300"></p>
    <div class="flex flex-wrap gap-3"><button data-publish-job type="button" class="q-primary" hidden><span data-i18n="revisado.40f808ded2ec43aa">Publicar oferta</span></button><button data-close-job type="button" class="q-secondary" hidden data-i18n="texto.Q2VycmFyIG9mZXJ0YQ">Cerrar oferta</button><button data-finish-job type="button" class="q-secondary" hidden><span data-i18n="revisado.2908ceb509186c73">Finalizar proceso</span></button></div>
  </section>
</div>
<dialog data-job-confirm aria-labelledby="job-confirm-title" aria-describedby="job-confirm-text" class="q-job-dialog m-auto w-[calc(100%-2rem)] max-w-lg rounded-xl bg-white p-6 text-slate-900 shadow-xl backdrop:bg-slate-950/60 dark:bg-slate-900 dark:text-white">
  <h2 id="job-confirm-title" class="text-xl font-semibold"></h2>
  <p id="job-confirm-text" class="my-5 break-words leading-relaxed"></p>
  <form method="dialog" class="flex flex-wrap gap-3"><button value="cancel" class="q-secondary" autofocus data-i18n="texto.Q2FuY2VsYXI">Cancelar</button><button data-job-confirm-action value="confirm" class="q-primary" data-i18n="texto.Q29uZmlybWFy">Confirmar</button></form>
</dialog>


<script>import { initVozOferta } from '../voz-oferta'; initVozOferta();</script>