---

---
<div data-job-editor hidden class="space-y-5">
  <a href="/reclutador/ofertas" class="q-link">Volver a mis ofertas</a>
  <div data-individual-note class="q-notice" hidden>Como reclutador particular, puedes crear y publicar todas tus ofertas completas.</div>
  <form data-job-form class="q-card p-5 sm:p-7">
    <fieldset data-job-fields class="min-w-0 space-y-6">
      <div class="flex flex-wrap items-start justify-between gap-4"><div><h2 class="text-xl font-semibold">Información de la oferta</h2><p class="mt-1 text-sm leading-6 text-slate-600 dark:text-slate-300">Completa los datos del puesto y guarda tu avance. Los campos con * son obligatorios.</p></div><span data-editor-status class="q-job-badge" data-status="DRAFT">Borrador</span></div>
      <div class="grid gap-5 md:grid-cols-2">
        <div class="space-y-2"><label for="title" class="block font-medium">Cargo *</label><div class="relative"><svg aria-hidden="true" class="pointer-events-none absolute left-3 top-1/2 h-5 w-5 -translate-y-1/2 text-slate-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M8 7V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2M3 11h18M5 7h14a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V9a2 2 0 0 1 2-2Z"/></svg><input id="title" name="title" required minlength="1" maxlength="180" placeholder="Ej. Diseñador de producto" class="q-input pl-11" /></div></div>
        <div class="space-y-2"><label id="area-label" class="block font-medium">Área (opcional)</label><div data-editor-dropdown class="relative"><select id="area" name="area" hidden><option value="">Selecciona un área</option><option>Tecnología</option><option>Producto &amp; Diseño</option><option>Marketing</option><option>Recursos Humanos</option><option>Finanzas</option></select><button type="button" data-editor-dropdown-trigger aria-haspopup="menu" aria-expanded="false" class="inline-flex min-h-12 w-full items-center justify-between gap-3 rounded-lg border border-slate-300 bg-slate-50 px-4 text-left text-base font-medium text-slate-800 hover:bg-slate-100 focus-visible:outline-2 focus-visible:outline-sky-600 dark:border-slate-600 dark:bg-slate-800 dark:text-white dark:hover:bg-slate-700"><span data-editor-dropdown-label></span><svg aria-hidden="true" class="h-4 w-4 shrink-0" fill="none" viewBox="0 0 24 24"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m19 9-7 7-7-7"/></svg></button><div data-editor-dropdown-menu class="z-40 hidden min-w-52 rounded-lg border border-slate-200 bg-white p-2 shadow-lg dark:border-slate-700 dark:bg-slate-900"><ul role="menu"></ul></div></div></div>
      </div>
      <div class="grid gap-5 sm:grid-cols-2">
        <div class="space-y-2"><label id="modality-label" class="block font-medium">Modalidad (opcional)</label><div data-editor-dropdown class="relative"><select id="modality" name="modality" hidden><option value="">Selecciona una modalidad</option><option>Remoto</option><option>Presencial</option><option>Híbrido</option></select><button type="button" data-editor-dropdown-trigger aria-haspopup="menu" aria-expanded="false" class="inline-flex min-h-12 w-full items-center justify-between gap-3 rounded-lg border border-slate-300 bg-slate-50 px-4 text-left text-base font-medium text-slate-800 hover:bg-slate-100 focus-visible:outline-2 focus-visible:outline-sky-600 dark:border-slate-600 dark:bg-slate-800 dark:text-white dark:hover:bg-slate-700"><span data-editor-dropdown-label></span><svg aria-hidden="true" class="h-4 w-4 shrink-0" fill="none" viewBox="0 0 24 24"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m19 9-7 7-7-7"/></svg></button><div data-editor-dropdown-menu class="z-40 hidden min-w-52 rounded-lg border border-slate-200 bg-white p-2 shadow-lg dark:border-slate-700 dark:bg-slate-900"><ul role="menu"></ul></div></div></div>
        <div class="space-y-2"><label for="location" class="block font-medium">Ubicación (opcional)</label><input id="location" name="location" maxlength="180" list="job-cities" placeholder="Ej. Lima, Perú" class="q-input" /><datalist id="job-cities"><option value="Lima, Perú"></option><option value="Abancay, Perú"></option><option value="Cusco, Perú"></option><option value="Arequipa, Perú"></option></datalist></div>
      </div>
      <div class="space-y-2"><label for="description" class="block font-medium">Descripción del puesto</label><div class="overflow-hidden rounded-lg border border-slate-300 dark:border-slate-600"><div class="flex gap-1 border-b border-slate-200 bg-slate-50 p-2 dark:border-slate-600 dark:bg-slate-800" role="group" aria-label="Formato de descripción"><button type="button" data-description-format="bold" aria-label="Insertar marcas de negrita" title="Negrita" class="min-h-11 min-w-11 rounded-lg font-bold hover:bg-slate-200 dark:hover:bg-slate-700">N</button><button type="button" data-description-format="italic" aria-label="Insertar marcas de cursiva" title="Cursiva" class="min-h-11 min-w-11 rounded-lg italic hover:bg-slate-200 dark:hover:bg-slate-700">I</button><button type="button" data-description-format="list" aria-label="Insertar viñeta" title="Lista" class="min-h-11 min-w-11 rounded-lg hover:bg-slate-200 dark:hover:bg-slate-700">☰</button></div><textarea id="description" name="description" rows="6" maxlength="10000" class="q-input !rounded-none !border-0" placeholder="Describe las funciones, condiciones y lo que ofrece el puesto." aria-describedby="description-help"></textarea></div><p id="description-help" class="text-sm text-slate-600 dark:text-slate-300">Hasta 10 000 caracteres. Los controles insertan marcas de texto visibles.</p></div>
      <div class="space-y-2"><label for="requirements" class="block font-medium">Requisitos y habilidades</label><textarea id="requirements" name="requirements" rows="4" maxlength="50049" class="q-input" placeholder="Escribe un requisito por línea&#10;Ej. Experiencia trabajando en equipo" aria-describedby="requirements-help"></textarea><p id="requirements-help" class="text-sm text-slate-600 dark:text-slate-300">Un requisito por línea. Hasta 50 requisitos de 1000 caracteres cada uno.</p></div>
      <div class="grid gap-5 md:grid-cols-2"><div class="space-y-2"><label for="experience_required" class="block font-medium">Experiencia requerida (opcional)</label><textarea id="experience_required" name="experience_required" rows="3" maxlength="2000" class="q-input" placeholder="Ej. Dos años de experiencia en diseño de productos digitales"></textarea></div><div class="space-y-2"><label for="education_required" class="block font-medium">Formación académica (opcional)</label><textarea id="education_required" name="education_required" rows="3" maxlength="2000" class="q-input" placeholder="Ej. Estudios técnicos o universitarios en Diseño"></textarea></div></div>
      <div class="flex flex-wrap items-center gap-3 border-t border-slate-200 pt-5 dark:border-slate-700">
        <button data-save-job class="q-primary" type="submit">Guardar borrador</button>
        <button data-discard-job class="q-secondary" type="button">Descartar cambios</button>
        <p data-dirty-message role="status" class="text-slate-600 dark:text-slate-300">Sin cambios pendientes.</p>
      </div>
    </fieldset>
  </form>
  <section data-publication class="q-card space-y-4 p-5 sm:p-7" hidden aria-labelledby="publication-title">
    <div class="flex flex-wrap items-center justify-between gap-3"><h2 id="publication-title" class="text-xl font-semibold">Publicación</h2><span data-job-id class="text-slate-600 dark:text-slate-300"></span></div>
    <p data-publication-help class="max-w-prose leading-relaxed text-slate-600 dark:text-slate-300"></p>
    <div class="flex flex-wrap gap-3"><button data-publish-job type="button" class="q-primary" hidden>Publicar oferta</button><button data-close-job type="button" class="q-secondary" hidden>Cerrar oferta</button><button data-finish-job type="button" class="q-secondary" hidden>Finalizar proceso</button></div>
  </section>
</div>
<dialog data-job-confirm aria-labelledby="job-confirm-title" aria-describedby="job-confirm-text" class="q-job-dialog m-auto w-[calc(100%-2rem)] max-w-lg rounded-xl bg-white p-6 text-slate-900 shadow-xl backdrop:bg-slate-950/60 dark:bg-slate-900 dark:text-white">
  <h2 id="job-confirm-title" class="text-xl font-semibold"></h2>
  <p id="job-confirm-text" class="my-5 break-words leading-relaxed"></p>
  <form method="dialog" class="flex flex-wrap gap-3"><button value="cancel" class="q-secondary" autofocus>Cancelar</button><button data-job-confirm-action value="confirm" class="q-primary">Confirmar</button></form>
</dialog>
