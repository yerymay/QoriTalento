---
import Marca from './Marca.astro';
import Tema from './Tema.astro';
import AltoContraste from '../../compartido/components/AltoContraste.astro';
---
<main id="contenido" tabindex="-1" class="relative isolate min-h-screen overflow-hidden bg-slate-50 px-5 py-6 text-slate-900 dark:bg-slate-950 dark:text-white sm:px-8 sm:py-8">
  <div aria-hidden="true" class="pointer-events-none absolute -left-36 -top-44 h-[430px] w-[430px] rounded-full bg-sky-100 dark:bg-sky-950/70"></div>
  <div aria-hidden="true" class="pointer-events-none absolute -bottom-40 -right-28 h-[360px] w-[360px] rounded-full bg-emerald-100 dark:bg-emerald-950/45"></div>
  <header class="relative mx-auto flex max-w-6xl items-center justify-between gap-4">
  <Marca />
  <div class="flex items-center gap-3">
    <AltoContraste />
        <Tema />
  </div>
</header>

  <section class="relative mx-auto flex max-w-5xl flex-col items-center pb-10 pt-16 text-center sm:pb-16 sm:pt-24">
    <h1 class="max-w-3xl text-balance text-4xl font-bold tracking-tight sm:text-5xl lg:text-[3.5rem] lg:leading-[1.08]"><span data-i18n="revisado.463248c98f302887">Personas, oportunidades y un proceso</span> <span class="text-sky-700 dark:text-sky-300" data-i18n="texto.Y29uZWN0YWRvLg">conectado.</span></h1>
    <p class="mt-4 max-w-xl text-lg text-slate-600 dark:text-slate-300" data-i18n="texto.RWxpZ2UgdW4gcm9sIHkgcmVjb3JyZSBsYXMgYWNjaW9uZXMgcHJpbmNpcGFsZXMu">Elige un rol y recorre las acciones principales.</p>
    <div class="mt-10 grid w-full max-w-4xl gap-5 text-left md:grid-cols-2">
      <article class="q-card p-6 shadow-sm sm:p-7">
        <div class="flex items-start gap-4"><span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-sky-100 text-sky-700 dark:bg-sky-950 dark:text-sky-300"><svg aria-hidden="true" class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="7" width="18" height="13" rx="2"/><path d="M8 7V5a4 4 0 0 1 8 0v2M3 12h18"/></svg></span><div><p class="text-sm font-semibold text-sky-700 dark:text-sky-300" data-i18n="texto.UGFyYSByZWNsdXRhZG9yZXM">Para reclutadores</p><h2 class="text-2xl font-bold tracking-tight" data-i18n="texto.UmVjbHV0YWRvcg">Reclutador</h2></div></div>
        <p class="mt-5 leading-7 text-slate-600 dark:text-slate-300" data-i18n="texto.Q3JlYSB1bmEgb2ZlcnRhLCByZXZpc2EgY2FuZGlkYXRvcyB5IGNvbmZpZ3VyYSBzdXMgZXZhbHVhY2lvbmVzLg">Crea una oferta, revisa candidatos y configura sus evaluaciones.</p>
        <ul class="mt-5 space-y-2 text-sm font-medium text-slate-700 dark:text-slate-200"><li class="flex gap-2"><span class="text-sky-700 dark:text-sky-300">✓</span><span data-i18n="revisado.4046bbeb6eec0772">Publica ofertas y recibe postulaciones</span></li><li class="flex gap-2"><span class="text-sky-700 dark:text-sky-300">✓</span><span data-i18n="revisado.60dc95c3fa91089d">Compara candidatos con evidencia</span></li><li class="flex gap-2"><span class="text-sky-700 dark:text-sky-300">✓</span><span data-i18n="revisado.2641da414577d3fa">Crea evaluaciones por oferta</span></li></ul>
        <a href="/login?role=RECRUITER" class="q-primary mt-6 flex w-full items-center justify-center" data-i18n="texto.SW5pY2lhciBjb21vIHJlY2x1dGFkb3I">Iniciar como reclutador</a>
      </article>
      <article class="q-card p-6 shadow-sm sm:p-7">
        <div class="flex items-start gap-4"><span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-emerald-100 text-emerald-700 dark:bg-emerald-950 dark:text-emerald-300"><svg aria-hidden="true" class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="8" r="3.5"/><path d="M5 21v-2a7 7 0 0 1 14 0v2"/></svg></span><div><p class="text-sm font-semibold text-emerald-700 dark:text-emerald-300" data-i18n="texto.UGFyYSBwb3N0dWxhbnRlcw">Para postulantes</p><h2 class="text-2xl font-bold tracking-tight" data-i18n="texto.UG9zdHVsYW50ZQ">Postulante</h2></div></div>
        <p class="mt-5 leading-7 text-slate-600 dark:text-slate-300" data-i18n="texto.RXhwbG9yYSBvcG9ydHVuaWRhZGVzLCBlbnY_YSB0dSBDViB5IGNvbXBsZXRhIHVuYSBldmFsdWFjaT9uLg">Explora oportunidades, envía tu CV y completa una evaluación.</p>
        <ul class="mt-5 space-y-2 text-sm font-medium text-slate-700 dark:text-slate-200"><li class="flex gap-2"><span class="text-emerald-700 dark:text-emerald-300">✓</span><span data-i18n="revisado.bc6341cb521d2ec6">Encuentra ofertas que encajen contigo</span></li><li class="flex gap-2"><span class="text-emerald-700 dark:text-emerald-300">✓</span><span data-i18n="revisado.6fc93cd5b408df59">Envía tu CV en PDF y revisa tus datos</span></li><li class="flex gap-2"><span class="text-emerald-700 dark:text-emerald-300">✓</span><span data-i18n="revisado.30950a7b345ed083">Sigue tu proceso en cada etapa</span></li></ul>
        <a href="/login?role=CANDIDATE" class="q-primary mt-6 flex w-full items-center justify-center" data-i18n="texto.SW5pY2lhciBjb21vIHBvc3R1bGFudGU">Iniciar como postulante</a>
      </article>
    </div>
  </section>
  <!-- 
  <p class="relative mx-auto max-w-4xl text-center text-sm text-slate-500 dark:text-slate-400">Prototipo de navegación · Datos de ejemplo · No se guardan cambios reales</p>
  Footer  -->

  </main>

