---
interface Props { inverse?:boolean }
const {inverse=false}=Astro.props;
---
<a href="/" class:list={['inline-flex min-h-11 items-center gap-3 font-bold tracking-tight',inverse ? 'text-white':'text-slate-900 dark:text-white']} aria-label="Qori Talento, inicio">
  <span class:list={['flex h-10 w-10 items-center justify-center rounded-xl text-xl',inverse ? 'bg-white text-sky-900':'bg-sky-700 text-white']}>Q</span>
  <span>QORITALENTO</span>
</a>
