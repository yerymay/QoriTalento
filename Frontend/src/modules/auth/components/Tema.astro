<button data-theme type="button" class="q-secondary" aria-label="Cambiar tema claro u oscuro">Tema</button>
<script>
  document.querySelectorAll<HTMLButtonElement>('[data-theme]').forEach(button=>{
    const update=()=>{
      const dark=document.documentElement.classList.contains('dark');
      button.setAttribute('aria-label',dark?'Activar modo claro':'Activar modo oscuro');
      button.setAttribute('title',dark?'Activar modo claro':'Activar modo oscuro');
      button.innerHTML=dark
        ? '<svg aria-hidden="true" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12.8A9 9 0 1 1 11.2 3 7 7 0 0 0 21 12.8Z"/></svg><span class="sr-only">Cambiar tema</span>'
        : '<svg aria-hidden="true" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/></svg><span class="sr-only">Cambiar tema</span>';
    };
    update();
    button.addEventListener('click',()=>queueMicrotask(update));
  });
  document.querySelectorAll('[data-theme]').forEach(button=>button.addEventListener('click',()=>{
    const dark=document.documentElement.classList.toggle('dark');
    try{localStorage.setItem('qori-theme',dark?'dark':'light');}catch{/* Preferencia opcional. */}
  }));
</script>
