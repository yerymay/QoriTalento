---
interface Props { id: string; label: string; type: 'text'|'email'|'password'|'tel'; autocomplete: string; min?: number; max: number; describedby?: string; surface?: 'card' }
const { id, label, type, autocomplete, min, max, describedby, surface } = Astro.props;
---
<div class="group" data-validation-field>
  <div class="relative">
    <input id={id} name={id} type={type} required autocomplete={autocomplete} minlength={min} maxlength={max} pattern={type === 'email' ? "[^\\s@]+@[^\\s@]+\\.[^\\s@]+" : undefined} placeholder=" " aria-describedby={[`${id}-error`, describedby].filter(Boolean).join(' ')}
      class="peer block min-h-14 w-full appearance-none rounded-lg border border-slate-400 bg-transparent px-3 pb-2 pt-5 pe-12 text-base text-slate-900 focus:border-sky-700 focus:outline-none focus:ring-2 focus:ring-sky-700/30 group-data-[validation=error]:border-red-700 group-data-[validation=error]:focus:border-red-700 group-data-[validation=success]:border-emerald-700 group-data-[validation=success]:focus:border-emerald-700 dark:border-slate-500 dark:text-white dark:focus:border-sky-300 dark:group-data-[validation=error]:border-red-300 dark:group-data-[validation=success]:border-emerald-300" />
    <label for={id} class:list={["absolute inline-flex items-center start-3 top-2 z-10 origin-[0] -translate-y-4 scale-75 bg-white px-1 text-base text-slate-700 duration-150 peer-placeholder-shown:top-1/2 peer-placeholder-shown:-translate-y-1/2 peer-placeholder-shown:scale-100 peer-focus:top-2 peer-focus:-translate-y-4 peer-focus:scale-75 peer-focus:text-sky-700 dark:text-slate-300 dark:peer-focus:text-sky-300 group-data-[validation=error]:text-red-700 group-data-[validation=error]:peer-focus:text-red-700 group-data-[validation=success]:text-emerald-700 group-data-[validation=success]:peer-focus:text-emerald-700 dark:group-data-[validation=error]:text-red-300 dark:group-data-[validation=success]:text-emerald-300", surface === 'card' ? 'dark:bg-slate-900' : 'dark:bg-slate-950']} >{type === 'email' && <svg class="me-1.5 h-4 w-4 shrink-0" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24"><path stroke="currentColor" stroke-linecap="round" stroke-width="2" d="m3.5 5.5 7.893 6.036a1 1 0 0 0 1.214 0L20.5 5.5M4 19h16a1 1 0 0 0 1-1V6a1 1 0 0 0-1-1H4a1 1 0 0 0-1 1v12a1 1 0 0 0 1 1Z"/></svg>}{label}</label>
    {type === 'password' && <button type="button" data-password aria-pressed="false" aria-label={id === 'confirm_password' ? 'Mostrar contraseña de confirmación' : 'Mostrar contraseña'} title={id === 'confirm_password' ? 'Mostrar contraseña de confirmación' : 'Mostrar contraseña'} class="absolute inset-y-0 end-0 inline-flex min-w-12 items-center justify-center rounded-e-lg text-slate-600 hover:text-sky-700 focus-visible:outline-2 focus-visible:outline-offset-[-3px] focus-visible:outline-sky-700 dark:text-slate-300 dark:hover:text-sky-300">
      <svg aria-hidden="true" class="password-eye h-5 w-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><g class="eye-open"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2 12s3.5-6 10-6 10 6 10 6-3.5 6-10 6S2 12 2 12Z"/><circle cx="12" cy="12" r="3" stroke="currentColor" stroke-width="2"/></g><g class="eye-closed"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10c2 2.5 5.1 4 9 4s7-1.5 9-4M5 13l-1 2m5-1-.5 3m7.5-3 .5 3m2.5-4 1 2"/></g></svg>
    </button>}
  </div>
  <p id={`${id}-error`} data-field-error={id} class="mt-2 text-sm text-red-700 group-data-[validation=success]:text-emerald-700 dark:text-red-300 dark:group-data-[validation=success]:text-emerald-300" aria-live="polite" hidden></p>
</div>

<style>
  .eye-open, .eye-closed { transform-origin: center; transition: opacity 180ms ease, transform 180ms ease; }
  .eye-open { opacity: 0; transform: scaleY(.2); }
  .eye-closed { opacity: 1; transform: scaleY(1); }
  button[aria-pressed="true"] .eye-open { opacity: 1; transform: scaleY(1); }
  button[aria-pressed="true"] .eye-closed { opacity: 0; transform: scaleY(.2); }
  @media (prefers-reduced-motion: reduce) { .eye-open, .eye-closed { transition: none; } }
</style>
