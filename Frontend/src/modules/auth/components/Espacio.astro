---
import Skeleton from '../../compartido/components/ui/Skeleton.astro';
import Panel from '../../compartido/components/ui/Panel.astro';
import Alert from '../../compartido/components/ui/Alert.astro';
import Button from '../../compartido/components/ui/Button.astro';
import Marca from './Marca.astro';


import MenuPerfil from './MenuPerfil.astro';
import Perfil from './Perfil.astro';
interface Props { view?:'profile'|'home'|'applications'|'settings'|'exams'; role?:'CANDIDATE'|'RECRUITER'; title?:string; description?:string; parentHref?:string; parentLabel?:string }
const {view='profile',role,title,description,parentHref,parentLabel}=Astro.props;
---
<div data-workspace data-view={view} data-role={role} class="workspace-shell min-h-screen">
  <aside data-i18n-aria-label="revisado.781509b25aa03251" id="account-sidebar" aria-label="Navegación principal" class="fixed inset-y-0 left-0 z-40 flex w-60 -translate-x-full flex-col border-r border-slate-200 bg-white p-5 transition-transform duration-200 motion-reduce:transition-none dark:border-slate-800 dark:bg-slate-900 lg:translate-x-0">
    <div class="flex items-center justify-between gap-2">
      <div class="sidebar-brand"><Marca /></div><button data-sidebar-collapse type="button" aria-label="Contraer navegación" aria-expanded="true" class="ui-button ui-button--icon hidden lg:inline-flex"><svg class="ui-icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="m14 6-6 6 6 6"/></svg></button>
      <button data-i18n-aria-label="revisado.f296f95ab8b39321" data-menu-close type="button" aria-label="Cerrar menú" class="inline-flex h-11 w-11 shrink-0 items-center justify-center rounded-lg text-slate-600 hover:bg-slate-100 focus-visible:outline-2 focus-visible:outline-sky-600 dark:text-slate-300 dark:hover:bg-slate-800 lg:hidden"><svg aria-hidden="true" class="h-5 w-5" fill="none" viewBox="0 0 24 24"><path stroke="currentColor" stroke-linecap="round" stroke-width="1.75" d="M6 18 18 6M18 18 6 6"/></svg></button>
    </div>
    <nav data-i18n-aria-label="revisado.222a5890db7a0817" id="account-nav" aria-label="Navegación de la cuenta" class="mt-6 min-h-0 flex-1 space-y-1 overflow-y-auto"><p class="sidebar-group px-4 pb-2 text-sm font-medium text-slate-600 dark:text-slate-300">Reclutamiento</p>
      <a data-home href="/login" class="q-nav" hidden><svg aria-hidden="true" class="h-5 w-5 shrink-0" fill="none" viewBox="0 0 24 24"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M9 7V5a3 3 0 0 1 6 0v2M4 8h16v11H4V8Zm0 5h16"/></svg><span data-home-label>Ofertas</span></a>
      <a data-app-nav href="/postulante/postulaciones" class:list={["q-nav", {"bg-sky-50 text-sky-800 dark:bg-sky-950 dark:text-sky-200":view==="applications"}]} aria-current={view==="applications"?"page":undefined} hidden><svg aria-hidden="true" class="h-5 w-5 shrink-0" fill="none" viewBox="0 0 24 24"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M9 5h6m-8 3h10M7 12h10M7 16h6M5 3h14v18H5V3Z"/></svg><span data-i18n="texto.TWlzIHBvc3R1bGFjaW9uZXM">Mis postulaciones</span></a>
      <a data-exam-nav href="/login" class:list={['q-nav', {'bg-sky-50 text-sky-800 dark:bg-sky-950 dark:text-sky-200':view==='exams'}]} aria-current={view==='exams'?'page':undefined} hidden><svg aria-hidden="true" class="h-5 w-5 shrink-0" fill="none" viewBox="0 0 24 24"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M8 4H5v17h14V4h-3M9 3h6v4H9zM8 12l2 2 5-5M8 18h8"/></svg><span data-i18n="texto.UHJ1ZWJhcyB0P2NuaWNhcw">Pruebas técnicas</span></a>
      <p class="sidebar-group px-4 pb-2 pt-6 text-sm font-medium text-slate-600 dark:text-slate-300">Cuenta</p>
      <a href="/perfil" class:list={['q-nav',{'bg-sky-50 text-sky-800 dark:bg-sky-950 dark:text-sky-200':view==='profile'}]} aria-current={view==='profile'?'page':undefined}><svg aria-hidden="true" class="h-5 w-5 shrink-0" fill="none" viewBox="0 0 24 24"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M12 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8Zm-7 8a7 7 0 0 1 14 0H5Z"/></svg><span data-i18n="texto.TWkgcGVyZmls">Mi perfil</span></a>
    </nav>
    <div class="mt-5 border-t border-slate-200 pt-4 dark:border-slate-700">
      <a href="/configuracion" class="q-nav" aria-current={view==='settings'?'page':undefined}><svg class="ui-icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M4 7h16M4 17h16M8 4v6m8 4v6"/></svg><span>Configuración</span></a>
      <a href="/configuracion#ayuda" class="q-nav"><svg class="ui-icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor"><circle cx="12" cy="12" r="9"/><path d="M9 9a3 3 0 0 1 6 0c0 2-3 2-3 5m0 2v1"/></svg><span>Ayuda</span></a>
      <p class="sidebar-group mt-4 text-sm leading-5 text-slate-600 dark:text-slate-300">Hecho para conectar<br /><span class="font-semibold text-slate-900 dark:text-white" data-i18n="texto.cGVyc29uYXMgeSBwb3NpYmlsaWRhZGVzLg">personas y posibilidades.</span></p>
    </div>
  </aside>
  <div class="min-w-0">
    <header class="sticky top-0 z-20 flex min-h-14 items-center justify-between gap-3 border-b border-slate-200 bg-panel px-4 py-1.5 dark:border-slate-800 dark:bg-slate-900 sm:px-8">
      <div class="flex min-w-0 items-center gap-2">
        <button data-i18n-aria-label="revisado.1a7de9bc490f0ea3" data-menu type="button" aria-label="Abrir menú" aria-expanded="false" aria-controls="account-sidebar" class="inline-flex h-11 w-11 shrink-0 items-center justify-center rounded-lg text-slate-700 hover:bg-slate-100 focus-visible:outline-2 focus-visible:outline-sky-600 dark:text-slate-200 dark:hover:bg-slate-800 lg:hidden"><svg aria-hidden="true" class="h-6 w-6" fill="none" viewBox="0 0 24 24"><path stroke="currentColor" stroke-linecap="round" stroke-width="1.75" d="M5 7h14M5 12h14M5 17h10"/></svg></button>
        <nav aria-label="Ruta de navegación" class="min-w-0 text-sm text-slate-600 dark:text-slate-300"><ol class="flex min-w-0 items-center gap-2"><li class:list={["shrink-0 whitespace-nowrap",{"hidden sm:block":!parentHref}]}><a href={parentHref ?? (view==='settings'||view==='profile'?'/perfil':'#contenido')} class="hover:underline">{parentLabel ?? (view==='settings'||view==='profile'?'Cuenta':'Reclutamiento')}</a></li><li aria-hidden="true" class:list={[{"hidden sm:block":!parentHref}]}>/</li><li aria-current="page" class="truncate font-medium text-slate-900 dark:text-white">{title ?? (view==='profile'?'Mi perfil':'Ofertas')}</li></ol></nav>
      </div>
      <div class="flex min-w-0 shrink items-center gap-3">


        <MenuPerfil />
      </div>
    </header>
    <main id="contenido" tabindex="-1" class="mx-auto w-full max-w-[1280px] space-y-6 p-4 sm:p-8">
      {view!=='profile' && <header class="flex flex-wrap items-start justify-between gap-4"><div><h1 class="text-3xl font-bold">{title ?? (role==='RECRUITER'?'Mis ofertas':'Encuentra tu próxima oportunidad')}</h1><p class="mt-2 text-slate-600 dark:text-slate-300">{description ?? 'Tu espacio según el rol de tu cuenta.'}</p></div><slot name="page-actions" /></header>}
      <Panel as="div" data-loading role="status" class="ui-panel space-y-5 p-6"><p data-i18n="texto.Q2FyZ2FuZG8gdHUgY3VlbnRhPw">Cargando tu cuenta…</p><Skeleton heights={["2rem","3rem","3rem"]} announce={false} /></Panel>
      <Alert as="div" data-feedback class="ui-alert" role="status" tabindex="-1" hidden></Alert>
      <Button variant="secondary" data-retry type="button" class="ui-button--secondary" hidden data-i18n="texto.UmVpbnRlbnRhcg">Reintentar</Button>
      <Button as="a" variant="primary" data-signin href="/login" class="ui-button--primary inline-flex items-center" hidden data-i18n="texto.SW5pY2lhciBzZXNpP24">Iniciar sesión</Button>
      <section data-private hidden>
        {view==='profile' ? <Perfil /> : <slot />}
        {view==='profile' && <slot name="profile-details" />}
      </section>
      <noscript>Activa JavaScript para consultar tu cuenta. Tus datos personales solo se cargan después de validar la sesión.</noscript>
    </main>
  </div>
</div>
<dialog data-expiry aria-labelledby="expiry-title" class="m-auto max-w-md rounded-xl bg-white p-6 text-slate-900 shadow-xl backdrop:bg-slate-950/60 dark:bg-slate-900 dark:text-white">
  <h2 id="expiry-title" class="text-xl font-bold" data-i18n="texto.VHUgc2VzaT9uIGVzdD8gcG9yIHRlcm1pbmFy">Tu sesión está por terminar</h2><p class="my-4" data-i18n="texto.TGxldmFzIHVuIHRpZW1wbyBzaW4gYWN0aXZpZGFkLiBDb250aW4_YSBwYXJhIG1hbnRlbmVyIHR1IHNlc2k_bi4">Llevas un tiempo sin actividad. Continúa para mantener tu sesión.</p><div class="flex flex-wrap gap-3"><Button variant="primary" data-continue class="ui-button--primary" type="button" data-i18n="texto.Q29udGludWFyIHNlc2k_bg">Continuar sesión</Button><Button variant="secondary" data-end class="ui-button--secondary" type="button" data-i18n="texto.Q2VycmFyIHNlc2k_bg">Cerrar sesión</Button></div>
</dialog>
<dialog data-confirm aria-labelledby="confirm-title" class="m-auto max-w-md rounded-xl bg-white p-6 text-slate-900 shadow-xl backdrop:bg-slate-950/60 dark:bg-slate-900 dark:text-white">
<h2 id="confirm-title" class="text-xl font-bold" data-i18n="texto.VnVlbHZlIGEgaW5pY2lhciBzZXNpP24">Vuelve a iniciar sesión</h2><p class="my-4" data-i18n="texto.RXN0ZSBjYW1iaW8gY2VycmFyPyB0dXMgc2VzaW9uZXMuIFBvZHI_cyB2b2x2ZXIgYSBpbmdyZXNhciBjb24gdHVzIGRhdG9zIGFjdHVhbGl6YWRvcy4">Este cambio cerrará tus sesiones. Podrás volver a ingresar con tus datos actualizados.</p><form method="dialog" class="flex flex-wrap gap-3"><Button variant="secondary" type="submit" value="cancel" class="ui-button--secondary" data-i18n="texto.Q2FuY2VsYXI">Cancelar</Button><Button variant="primary" type="submit" value="save" class="ui-button--primary" data-i18n="texto.R3VhcmRhciB5IGNlcnJhciBzZXNpP24">Guardar y cerrar sesión</Button></form>
</dialog>
<script>import { initWorkspace } from '../workspace'; initWorkspace();</script>

