---
import Panel from '../../compartido/components/ui/Panel.astro';
import AuthFeedback from './AuthFeedback.astro';
import AuthSubmit from './AuthSubmit.astro';
import '../auth.css';
import CampoLogin from './CampoLogin.astro';
import DropdownSelector from './DropdownSelector.astro';
import Marca from './Marca.astro';
interface Props { initialRole?: 'CANDIDATE'|'RECRUITER' }
const { initialRole='CANDIDATE' } = Astro.props;
const selectedRoleLabel = initialRole === 'RECRUITER' ? 'Reclutador' : 'Postulante';
---
<header class="flex items-center justify-between gap-4 border-b border-slate-200 bg-white px-4 py-4 dark:border-slate-800 dark:bg-slate-900 sm:px-9"><Marca /></header>
<main id="contenido" tabindex="-1" class="mx-auto max-w-7xl space-y-6 px-4 py-8 sm:px-9">
  <div class="grid items-start gap-10 lg:grid-cols-[minmax(280px,0.8fr)_minmax(0,1.2fr)] lg:gap-16">
    <section class="hidden space-y-5 pt-6 lg:block"><p class="font-semibold text-sky-700 dark:text-sky-300">Qori Talento</p><h1 class="max-w-md text-4xl font-bold leading-tight" data-i18n="texto.VW4gZXNwYWNpbyBwYXJhIGNhZGEgcGFzbyBkZWwgcHJvY2Vzby4">Un espacio para cada paso del proceso.</h1><p class="max-w-sm leading-7 text-slate-600 dark:text-slate-300" data-i18n="texto.RWxpZ2UgYz9tbyBwYXJ0aWNpcGFyLiBUdSBjdWVudGEgcXVlZGEgbGlzdGEgYWwgcmVnaXN0cmFydGUu">Elige cómo participar. Tu cuenta queda lista al registrarte.</p></section>
    <Panel as="section" class="ui-panel mx-auto w-full max-w-xl p-6 sm:p-8">
      <div class="mb-7"><h1 class="text-3xl font-bold" data-i18n="texto.Q3JlYSB0dSBjdWVudGE">Crea tu cuenta</h1><p class="mt-2 text-slate-600 dark:text-slate-300" data-i18n="texto.Q29tcGxldGEgdHVzIGRhdG9zIHBhcmEgcmVnaXN0cmFydGUu">Completa tus datos para registrarte.</p><p class="mt-4 inline-flex items-center gap-2 rounded-full bg-sky-50 px-3 py-2 text-sm font-semibold text-sky-800 dark:bg-sky-950 dark:text-sky-200"><span class="h-2 w-2 rounded-full bg-sky-600"></span>Crearás una cuenta como: <span data-role-summary>{selectedRoleLabel}</span></p></div>
      <form method="post" data-auth-form="register" class="space-y-5" novalidate>
        <DropdownSelector id="role" label="Quiero registrarme como" name="role" value={initialRole} options={[{value:'CANDIDATE',label:'Postulante'},{value:'RECRUITER',label:'Reclutador'}]} />
        <div data-recruiter hidden class="space-y-2">
          <DropdownSelector id="kind" label="Tipo de reclutador" name="kind" value="COMPANY" options={[{value:'COMPANY',label:'Empresa'},{value:'INDIVIDUAL',label:'Particular'}]} />
          <p class="text-sm text-slate-600 dark:text-slate-300" data-i18n="texto.U2kgcmVwcmVzZW50YXMgYSB1bmEgZW1wcmVzYSwgdXNhIHR1IGNvcnJlbyBjb3Jwb3JhdGl2by4">Si representas a una empresa, usa tu correo corporativo.</p>
        </div>
        <CampoLogin surface="card" id="name" label="Nombre completo" type="text" autocomplete="name" min={2} max={160} />
        <AuthFeedback />
        <CampoLogin surface="card" id="email" label="Correo electrónico" type="email" autocomplete="email" max={254} />
        <div data-phone-group hidden>
          <CampoLogin surface="card" id="phone" label="Teléfono de contacto" type="tel" autocomplete="tel" min={7} max={32} />
          <p class="mt-2 text-sm text-slate-600 dark:text-slate-300" data-i18n="texto.TmVjZXNhcmlvIHBhcmEgcmVjbHV0YWRvcmVzIHBhcnRpY3VsYXJlcy4">Necesario para reclutadores particulares.</p>
        </div>
        <div>
          <CampoLogin surface="card" id="password" label="Contraseña" type="password" autocomplete="new-password" min={8} max={128} describedby="password-rules" />
          <p id="password-rules" class="mt-2 text-sm text-slate-600 dark:text-slate-300">Usa al menos 8 caracteres.</p>
        </div>
        <CampoLogin surface="card" id="confirm_password" label="Confirmar contraseña" type="password" autocomplete="new-password" max={128} />
        <AuthSubmit register />
        <p class="text-center text-slate-600 dark:text-slate-300">¿Ya tienes cuenta? <a data-signin-link href={`/login?role=${initialRole}`} class="q-link" data-i18n="texto.SW5pY2lhIHNlc2k_bg">Inicia sesión</a></p>
        <p class="text-sm leading-6 text-slate-600 dark:text-slate-300">Tu cuenta queda lista al registrarte y puedes iniciar sesión de inmediato.</p>
      </form>
      <noscript>Activa JavaScript para registrar tu cuenta.</noscript>
    </Panel>
  </div>
</main>
<script>import { initAuthForm } from '../forms'; initAuthForm();</script>

