---
import Campo from './Campo.astro';
import Marca from './Marca.astro';
import Tema from './Tema.astro';
---
<header class="flex items-center justify-between gap-4 border-b border-slate-200 bg-white px-4 py-4 dark:border-slate-800 dark:bg-slate-900 sm:px-9"><Marca /><Tema /></header>
<main class="mx-auto max-w-7xl space-y-6 px-4 py-8 sm:px-9">
  <header><p class="font-semibold uppercase tracking-wide text-sky-700 dark:text-sky-300">Tu siguiente paso</p><h1 class="mt-2 text-4xl font-bold">Crea tu cuenta</h1><p class="mt-2 text-slate-600 dark:text-slate-300">Un nuevo comienzo, una nueva oportunidad.</p></header>
  <div class="grid gap-6 lg:grid-cols-2">
    <section class="flex flex-col justify-center gap-5 rounded-2xl bg-sky-900 p-8 text-white lg:p-12"><p class="text-sky-200">QORITALENTO</p><h2 class="text-4xl font-bold leading-tight">Grandes equipos. Nuevas posibilidades.</h2><p class="leading-7 text-sky-100">Un proceso de selección más claro para quienes buscan talento y quienes quieren crecer.</p></section>
    <section class="q-card p-6 sm:p-8">
      <form method="post" data-auth-form="register" class="space-y-5" novalidate>
        <Campo id="name" label="Nombre completo" required autocomplete="name" min={2} max={160} />
        <Campo id="email" label="Correo electrónico" type="email" required autocomplete="email" max={254} />
        <Campo id="password" label="Contraseña" type="password" required autocomplete="new-password" min={8} max={128} />
        <button data-password type="button" aria-pressed="false" class="q-secondary">Mostrar contraseña</button>
        <p data-strength class="text-slate-600 dark:text-slate-300" aria-live="polite">Fortaleza: escribe al menos 8 caracteres.</p>
        <div class="space-y-2"><label for="role" class="block font-medium">Quiero registrarme como</label><select id="role" name="role" class="q-input"><option value="CANDIDATE">Postulante</option><option value="RECRUITER">Reclutador</option></select></div>
        <div data-recruiter hidden class="space-y-2"><label for="kind" class="block font-medium">Tipo de reclutador</label><select id="kind" name="kind" class="q-input"><option value="COMPANY">Empresa (correo corporativo)</option><option value="INDIVIDUAL">Particular (requiere verificar teléfono)</option></select></div>
        <Campo id="phone" label="Teléfono de contacto" type="tel" autocomplete="tel" min={7} max={32} />
        <p data-message role="status" tabindex="-1" class="q-notice" hidden></p>
        <button data-submit type="submit" class="q-primary w-full" disabled>Registrar</button>
        <a href="/login" class="q-secondary inline-flex items-center">Ya tengo cuenta</a>
        <p class="text-slate-600 dark:text-slate-300">Tu cuenta permanecerá inactiva hasta verificarla. La verificación todavía no está disponible.</p>
      </form>
      <noscript>Activa JavaScript para registrar tu cuenta.</noscript>
    </section>
  </div>
</main>
<script>import { initAuthForm } from '../forms'; initAuthForm();</script>
