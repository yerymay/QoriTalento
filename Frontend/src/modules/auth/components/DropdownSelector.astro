---
interface Props { id: string; label: string; name: string; value: string; options: Array<{value: string; label: string}> }
const {id, label, name, value, options} = Astro.props;
const selected = options.find(option => option.value === value) ?? options[0];
---
<div data-select-dropdown class="space-y-2">
  <span id={`${id}-label`} class="block font-medium text-slate-700 dark:text-slate-200">{label}</span>
  <input id={id} name={name} type="hidden" value={selected.value} />
  <button id={`${id}-trigger`} type="button" data-dropdown-trigger aria-haspopup="menu" aria-expanded="false" aria-controls={`${id}-menu`} aria-labelledby={`${id}-label ${id}-selected`} class="inline-flex min-h-12 w-full items-center justify-between gap-3 rounded-lg border border-slate-300 bg-slate-50 px-3 py-3 text-left text-base text-slate-900 hover:bg-slate-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sky-700 disabled:opacity-60 dark:border-slate-600 dark:bg-slate-800 dark:text-white dark:hover:bg-slate-700">
    <span id={`${id}-selected`} data-dropdown-label>{selected.label}</span>
    <svg class="h-4 w-4 shrink-0" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m19 9-7 7-7-7"/></svg>
  </button>
  <div id={`${id}-menu`} data-dropdown-menu class="z-20 hidden min-w-56 rounded-lg border border-slate-200 bg-white p-2 shadow-lg dark:border-slate-600 dark:bg-slate-800">
    <ul role="menu" aria-labelledby={`${id}-label`}>
      {options.map(option => <li role="none"><button type="button" role="menuitemradio" aria-checked={option.value === selected.value ? 'true' : 'false'} tabindex="-1" data-dropdown-value={option.value} class="flex min-h-11 w-full items-center rounded px-3 text-left text-base text-slate-900 hover:bg-slate-100 focus-visible:bg-sky-50 focus-visible:outline-2 focus-visible:outline-sky-700 dark:text-white dark:hover:bg-slate-700 dark:focus-visible:bg-slate-700">{option.label}</button></li>)}
    </ul>
  </div>
</div>
