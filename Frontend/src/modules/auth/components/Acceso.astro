---
import CampoLogin from './CampoLogin.astro';
import Marca from './Marca.astro';
import Tema from './Tema.astro';
interface Props { initialRole?: 'CANDIDATE'|'RECRUITER' }
const { initialRole='RECRUITER' } = Astro.props;
---
<main class="min-h-screen lg:grid lg:grid-cols-[minmax(360px,39%)_1fr]">
  <section class="relative hidden flex-col justify-between gap-12 overflow-hidden bg-sky-900 px-6 py-8 text-white sm:p-12 lg:flex lg:min-h-screen lg:p-14">
    <img src="/images/auth/2f5ba.svg" alt="" class="pointer-events-none absolute left-64 top-[420px]" />
    <img src="/images/auth/9fb29.svg" alt="" class="pointer-events-none absolute -left-30 -top-28" />
    <div class="relative"><Marca inverse /></div>
    <div class="relative max-w-lg space-y-6">
      <h1 class="text-4xl font-bold leading-tight lg:text-5xl">Grandes equipos.<br />Nuevas posibilidades.</h1>
      <p class="text-lg leading-7 text-sky-200">Un proceso de selección más claro para quienes buscan talento y quienes quieren crecer.</p>
      <ul class="hidden space-y-4 lg:block">
        {[['354be','Un proceso de selección claro, etapa por etapa'],['0661e','Resultados y comparación en un solo lugar'],['ea363','Evaluaciones y seguimiento sin sorpresas']].map(([icon,label])=><li class="flex items-center gap-3"><span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-white/10"><img src={`/images/auth/${icon}.svg`} alt="" /></span>{label}</li>)}
      </ul>
    </div>
    <p class="relative hidden text-sky-200 lg:block">Hecho para conectar personas y posibilidades.</p>
  </section>
  <section class="flex flex-col justify-center bg-white p-6 py-8 dark:bg-slate-950 sm:p-12">
    <div class="mb-10 flex items-center justify-between gap-4 lg:justify-end"><div class="lg:hidden"><Marca /></div><Tema /></div>
    <div class="mx-auto w-full max-w-md space-y-6">
      <header><h2 class="text-3xl font-bold">Bienvenido de nuevo</h2><p class="mt-2 text-slate-600 dark:text-slate-300">Conecta talento con oportunidades.</p></header>
      <form method="post" data-auth-form="login" data-initial-role={initialRole} class="space-y-5" novalidate>
        <fieldset class="space-y-2">
          <legend class="block text-sm font-medium text-slate-700 dark:text-slate-200">Ingresar como</legend>
          <div class="grid grid-cols-2 rounded-xl bg-slate-100 p-1 dark:bg-slate-800" role="group" aria-label="Tipo de acceso">
            <button data-role-choice data-role="RECRUITER" data-role-label="Reclutador" type="button" aria-pressed="true" class="inline-flex min-h-11 items-center justify-center gap-2 rounded-lg px-3 text-sm font-semibold text-sky-800 transition-colors duration-150 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sky-600 dark:text-sky-200"><svg aria-hidden="true" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="4" y="7" width="16" height="13" rx="2"/><path d="M9 7V5a3 3 0 0 1 6 0v2M3 12h18"/></svg>Reclutador</button>
            <button data-role-choice data-role="CANDIDATE" data-role-label="Postulante" type="button" aria-pressed="false" class="inline-flex min-h-11 items-center justify-center gap-2 rounded-lg bg-white px-3 text-sm font-semibold text-slate-900 shadow-sm transition-colors duration-150 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sky-600 dark:bg-slate-900 dark:text-white"><svg aria-hidden="true" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="8" r="3"/><path d="M5 21v-2a7 7 0 0 1 14 0v2"/></svg>Postulante</button>
          </div>
          <p data-role-hint class="text-sm text-slate-600 dark:text-slate-300">Accede a tus ofertas y procesos de selección.</p>
        </fieldset>
        <CampoLogin id="email" label="Correo electrónico" type="email" autocomplete="username" max={254} />
        <CampoLogin id="password" label="Contraseña" type="password" autocomplete="current-password" max={128} />

        <p data-message role="status" tabindex="-1" class="q-notice" hidden></p>
        <button data-submit type="submit" class="q-primary flex w-full items-center justify-center gap-2">Iniciar sesión<svg aria-hidden="true" class="h-5 w-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 5l7 7-7 7M20 12H4"/></svg></button>
      </form>
      <p class="flex flex-wrap items-center justify-center gap-2 text-slate-600 dark:text-slate-300">¿Aún no tienes cuenta? <a data-register-link href={`/registro?role=${initialRole}`} class="q-link">Crear una cuenta</a></p>
      <p class="text-sm leading-6 text-slate-600 dark:text-slate-300">Tu cuenta queda lista al registrarte y puedes iniciar sesión de inmediato.</p>
      <noscript>Activa JavaScript para iniciar sesión.</noscript>
    </div>
  </section>
</main>
<script>import { initAuthForm } from '../forms'; initAuthForm();</script>
