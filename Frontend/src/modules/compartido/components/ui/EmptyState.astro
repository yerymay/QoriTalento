---
interface Props {
  title?: string;
  description?: string;
  align?: 'center' | 'start';
  class?: string;
  [key: string]: unknown;
}
const {title, description, align='center', class:className, ...attrs} = Astro.props;
---
<div {...attrs} class:list={['ui-empty', {'ui-empty--start': align==='start'}, className]}>
  <slot name="icon"><svg aria-hidden="true" viewBox="0 0 24 24" class="ui-icon" fill="none" stroke="currentColor" stroke-width="1.75"><path d="M4 4h16v16H4zM8 9h8M8 13h5"/></svg></slot>
  <div class="ui-empty-content">
    <slot name="title"><h3 class="text-xl font-semibold">{title}</h3></slot>
    <slot name="description"><p class="mt-3">{description}</p></slot>
    <div class="mt-5"><slot /></div>
  </div>
</div>
