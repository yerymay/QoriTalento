---
import '../styles/global.css';
import Toast from '../modules/compartido/components/Toast.astro';
interface Props { title: string; systemAppearance?: boolean }
const { title, systemAppearance=false } = Astro.props;
---
<!doctype html>
<html lang="es" data-appearance={systemAppearance?'system':undefined}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Qori Talento — plataforma de reclutamiento" />
    <title>{title}</title>
    <script is:inline>
      try {
        const system = document.documentElement.dataset.appearance === 'system';
        const chosen = system ? 'system' : localStorage.getItem('qori-theme');
        const dark = chosen === 'dark' || (chosen !== 'light' && matchMedia('(prefers-color-scheme: dark)').matches);
        document.documentElement.classList.toggle('dark', dark);
        const contraste = system ? null : localStorage.getItem('qori-contrast');
        if (contraste === 'high' || (contraste !== 'normal' && matchMedia('(prefers-contrast: more)').matches)) document.documentElement.dataset.contraste = 'alto';
      } catch { /* El sistema funciona sin persistencia de tema */ }
    </script>
  </head>
  <body class="min-h-screen bg-canvas text-slate-900 dark:text-slate-50">
    <a href="#contenido" class="q-skip">Saltar al contenido</a>
    <slot />
    <Toast />
    <script>
      import { iniciarIdiomas } from '../modules/compartido/i18n';
      iniciarIdiomas();
      import { iniciarApariencia } from '../modules/compartido/apariencia';
      iniciarApariencia();
    </script>
  </body>
</html>


