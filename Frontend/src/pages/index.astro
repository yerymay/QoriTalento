---
import BaseLayout from '../layouts/BaseLayout.astro';
import EstadoConexion from '../modules/compartido/components/EstadoConexion.astro';
---
<BaseLayout title="Qori Talento — Inicio MVP">
  <main class="mx-auto max-w-3xl px-4 py-12 sm:px-8">
    <header class="mb-8 flex items-start justify-between gap-4">
      <div>
        <p class="mb-1 text-sm font-semibold uppercase tracking-wide text-sky-700 dark:text-sky-400">MVP · Interacción Humano-Computador</p>
        <h1 class="text-4xl font-bold tracking-tight">Qori Talento</h1>
        <p class="mt-2 max-w-xl text-slate-600 dark:text-slate-300">Primera conexión entre frontend modular, API por cuatro capas y MySQL/MariaDB. Los ocho módulos se implementarán de manera progresiva.</p>
      </div>
      <button id="theme" type="button" class="min-h-11 shrink-0 rounded-lg border border-slate-300 px-4 py-2 text-sm font-medium hover:bg-slate-100 focus:ring-4 focus:ring-sky-300 dark:border-slate-700 dark:hover:bg-slate-800" aria-label="Cambiar tema claro u oscuro">Tema</button>
    </header>
    <EstadoConexion />
    <p class="mt-6 text-sm text-slate-600 dark:text-slate-400">Swagger: <a class="font-medium text-sky-700 underline hover:text-sky-800 dark:text-sky-400" href="http://127.0.0.1:3001/api-docs/" target="_blank" rel="noopener noreferrer">API documentada (rutas implementadas)</a></p>
    <p class="mt-3 text-xs text-slate-500 dark:text-slate-400">Esta pantalla es la comprobación de integración, no reemplaza las pantallas Figma.</p>
  </main>
  <script>
    document.querySelector('#theme')?.addEventListener('click', () => {
      const dark = document.documentElement.classList.toggle('dark');
      try { localStorage.setItem('qori-theme', dark ? 'dark' : 'light'); } catch { /* opcional */ }
    });
  </script>
</BaseLayout>
